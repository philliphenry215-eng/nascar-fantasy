id_fk\" FOREIGN KEY (\"race_id\") REFERENCES \"public\".\"races\"(\"id\") ON DELETE no action ON UPDATE no action;\nALTER TABLE \"weekly_picks\" ADD CONSTRAINT \"weekly_picks_series_id_series_config_id_fk\" FOREIGN KEY (\"series_id\") REFERENCES \"public\".\"series_config\"(\"id\") ON DELETE no action ON UPDATE no action;\nALTER TABLE \"weekly_picks\" ADD CONSTRAINT \"weekly_picks_driver_id_drivers_id_fk\" FOREIGN KEY (\"driver_id\") REFERENCES \"public\".\"drivers\"(\"id\") ON DELETE no action ON UPDATE no action;\nCREATE UNIQUE INDEX \"idx_driver_series_nascar_id\" ON \"drivers\" USING btree (\"nascar_driver_id\",\"series_id\");\nCREATE UNIQUE INDEX \"idx_race_nascar_driver\" ON \"race_driver_results\" USING btree (\"race_id\",\"nascar_driver_id\");\nCREATE UNIQUE INDEX \"idx_user_slot_unique\" ON \"season_rosters\" USING btree (\"user_id\",\"slot_type\");\nCREATE UNIQUE INDEX \"idx_user_race_pick\" ON \"weekly_picks\" USING btree (\"user_id\",\"race_id\");\n\n[\342\234\223] Changes applied\n"
