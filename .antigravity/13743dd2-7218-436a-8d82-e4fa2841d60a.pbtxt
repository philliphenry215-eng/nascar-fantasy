  planner_response {
    thinking: "**Defining File Structure**\n\nI\'m now focusing on creating `src/db/repository.ts` and `server.ts`. For `src/db/repository.ts`, I\'m strictly adhering to the `cloudsql-setup` guidelines, particularly with explicit file extensions for all relative imports to maintain clarity and avoid potential import issues.\n\n\n**Implementing Query Functions**\n\nI\'m currently working on incorporating Drizzle\'s type-safe query APIs within the repository. I\'m focusing on error translation using `try/catch` blocks, ensuring clean error handling. Furthermore, I\'ve implemented `getOrCreateUser` using `onConflictDoUpdate` to seamlessly bind user data from Google Sign-In with existing placeholder entries. I\'ve also checked `server.ts` to determine which endpoints should be exposed.\n\n\n**Defining API Endpoints**\n\nI\'m now determining the structure and functionality of several API endpoints. I am defining `/auth/sync` for Firebase user synchronization with PostgreSQL, employing `getOrCreateUser` to link user profiles. The automated NASCAR Data Pipeline, `/api/nascar-sync`, will retrieve and process NASCAR data, calculating points and applying rules. I\'m also planning `/api/weekly-pick` and `/api/season-roster` for user pick and roster management with rule enforcements.\n\n\n"
    tool_calls {
      id: "call_17543957402814278751"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { eq, and, ne } from \'drizzle-orm\';\\nimport { db } from \'./index.ts\';\\nimport {\\n  users,\\n  seriesConfig,\\n  drivers,\\n  races,\\n  seasonRosters,\\n  weeklyPicks,\\n  raceDriverResults,\\n} from \'./schema.ts\';\\nimport {\\n  processRaceResultsWithOwnerFallback,\\n  NascarFeedResult,\\n  NascarStageFeed,\\n  ComputedRaceResult,\\n} from \'../lib/nascar-scoring-engine.ts\';\\n\\nexport async function getOrCreateUser(\\n  uid: string,\\n  email: string,\\n  displayName?: string\\n) {\\n  try {\\n    // Check if user already exists by uid\\n    const existingByUid = await db\\n      .select()\\n      .from(users)\\n      .where(eq(users.uid, uid));\\n\\n    if (existingByUid.length > 0) {\\n      const updated = await db\\n        .update(users)\\n        .set({\\n          email,\\n          name: displayName ? `${displayName} (You)` : existingByUid[0].name,\\n        })\\n        .where(eq(users.uid, uid))\\n        .returning();\\n      return updated[0];\\n    }\\n\\n    // Check if primary seat \'u1\' is still bound to seed-uid-u1; if so, bind to this authenticated user\\n    const primarySeat = await db\\n      .select()\\n      .from(users)\\n      .where(eq(users.id, \'u1\'));\\n\\n    if (primarySeat.length > 0 && primarySeat[0].uid === \'seed-uid-u1\') {\\n      const bound = await db\\n        .update(users)\\n        .set({\\n          uid,\\n          email,\\n          name: displayName ? `${displayName} (You)` : primarySeat[0].name,\\n        })\\n        .where(eq(users.id, \'u1\'))\\n        .returning();\\n      return bound[0];\\n    }\\n\\n    // Otherwise upsert a new league member record using Drizzle\'s onConflictDoUpdate\\n    const avatarInitials = (displayName || email || \'PB\')\\n      .split(\' \')\\n      .map((p) => p[0])\\n      .join(\'\')\\n      .toUpperCase()\\n      .slice(0, 2);\\n\\n    const result = await db\\n      .insert(users)\\n      .values({\\n        id: `user_${uid.slice(0, 8)}`,\\n        uid,\\n        email,\\n        name: displayName || email.split(\'@\')[0] || \'Pit Box Manager\',\\n        avatar: avatarInitials || \'PB\',\\n        lastYearRank: 7,\\n        role: \'member\',\\n        cumulativePriorPoints: 2250,\\n      })\\n      .onConflictDoUpdate({\\n        target: users.uid,\\n        set: {\\n          email,\\n        },\\n      })\\n      .returning();\\n\\n    return result[0];\\n  } catch (error) {\\n    console.error(\'Database error in getOrCreateUser:\', error);\\n    throw new Error(\'Failed to synchronize user profile.\', { cause: error });\\n  }\\n}\\n\\nexport function buildWeekendSimulationFeeds(\\n  firstPlacePoints: 55 | 40,\\n  simulateZilischInjury: boolean\\n): Record<1 | 2 | 3, ComputedRaceResult[]> {\\n  // 1. CUP SERIES (Sunday)\\n  const cupRaw: NascarFeedResult[] = [\\n    { driver_id: 4001, driver_fullname: \'Kyle Larson\', car_number: \'5\', team_name: \'Hendrick Motorsports\', finishing_position: 1, points_earned: firstPlacePoints + 10, fastest_lap: true },\\n    { driver_id: 4003, driver_fullname: \'Ryan Blaney\', car_number: \'12\', team_name: \'Team Penske\', finishing_position: 2, points_earned: 35 + 8 },\\n    { driver_id: 4004, driver_fullname: \'Christopher Bell\', car_number: \'20\', team_name: \'Joe Gibbs Racing\', finishing_position: 3, points_earned: 34 + 6 },\\n    { driver_id: 4002, driver_fullname: \'William Byron\', car_number: \'24\', team_name: \'Hendrick Motorsports\', finishing_position: 4, points_earned: 33 + 5 },\\n    { driver_id: 4101, driver_fullname: \'Kyle Busch\', car_number: \'8\', team_name: \'Richard Childress Racing\', finishing_position: 5, points_earned: 32 + 4 },\\n    { driver_id: 4005, driver_fullname: \'Denny Hamlin\', car_number: \'11\', team_name: \'Joe Gibbs Racing\', finishing_position: 6, points_earned: 31 + 2 },\\n    { driver_id: 4006, driver_fullname: \'Chase Elliott\', car_number: \'9\', team_name: \'Hendrick Motorsports\', finishing_position: 7, points_earned: 30 + 3 },\\n    { driver_id: 4102, driver_fullname: \'Chris Buescher\', car_number: \'17\', team_name: \'RFK Racing\', finishing_position: 8, points_earned: 29 },\\n    { driver_id: 4104, driver_fullname: \'Ross Chastain\', car_number: \'1\', team_name: \'Trackhouse Racing\', finishing_position: 9, points_earned: 28 },\\n    { driver_id: 4103, driver_fullname: \'Bubba Wallace\', car_number: \'23\', team_name: \'23XI Racing\', finishing_position: 12, points_earned: 25 },\\n    { driver_id: 4105, driver_fullname: \'Ty Gibbs\', car_number: \'54\', team_name: \'Joe Gibbs Racing\', finishing_position: 14, points_earned: 23 },\\n    { driver_id: 4106, driver_fullname: \'Michael McDowell\', car_number: \'71\', team_name: \'Spire Motorsports\', finishing_position: 18, points_earned: 19 },\\n  ];\\n  const cupStages: NascarStageFeed[] = [\\n    { stage_num: 1, results: [{ driver_id: 4001, car_number: \'5\', stage_points: 10 }, { driver_id: 4003, car_number: \'12\', stage_points: 8 }] },\\n  ];\\n\\n  // 2. O\'REILLY\'S SERIES (Saturday) - Features Buschwhackers (points_earned: 0) & Car Anchor Sub\\n  const oreillysRaw: NascarFeedResult[] = [\\n    {\\n      driver_id: 4001,\\n      driver_fullname: \'Kyle Larson\',\\n      car_number: simulateZilischInjury ? \'88\' : \'17\',\\n      team_name: simulateZilischInjury ? \'JR Motorsports (Relief Sub)\' : \'Hendrick Motorsports\',\\n      finishing_position: 1,\\n      points_earned: 0, // BUSCHWHACKER RULE TRIGGER: 0 Official Driver Points!\\n      fastest_lap: true,\\n    },\\n    {\\n      driver_id: 4006,\\n      driver_fullname: \'Chase Elliott\',\\n      car_number: \'9\',\\n      team_name: \'JR Motorsports\',\\n      finishing_position: 2,\\n      points_earned: 0, // BUSCHWHACKER RULE TRIGGER: 2nd (35) + Stage (14) = 49 Owner Pts!\\n    },\\n    ...(!simulateZilischInjury\\n      ? [\\n          {\\n            driver_id: 5001,\\n            driver_fullname: \'Connor Zilisch\',\\n            car_number: \'88\',\\n            team_name: \'JR Motorsports\',\\n            finishing_position: 3,\\n            points_earned: 42,\\n          },\\n        ]\\n      : []),\\n    { driver_id: 5002, driver_fullname: \'Justin Allgaier\', car_number: \'7\', team_name: \'JR Motorsports\', finishing_position: 4, points_earned: 41 },\\n    { driver_id: 5003, driver_fullname: \'Austin Hill\', car_number: \'21\', team_name: \'Richard Childress Racing\', finishing_position: 5, points_earned: 36 },\\n    { driver_id: 5004, driver_fullname: \'Jesse Love\', car_number: \'2\', team_name: \'Richard Childress Racing\', finishing_position: 6, points_earned: 34 },\\n    { driver_id: 5005, driver_fullname: \'Sheldon Creed\', car_number: \'00\', team_name: \'Haas Factory Team\', finishing_position: 8, points_earned: 30 },\\n    { driver_id: 5006, driver_fullname: \'Carson Kvapil\', car_number: \'1\', team_name: \'JR Motorsports\', finishing_position: 10, points_earned: 27 },\\n  ];\\n\\n  const oreillysStages: NascarStageFeed[] = [\\n    {\\n      stage_num: 1,\\n      results: [\\n        { driver_id: 4001, car_number: simulateZilischInjury ? \'88\' : \'17\', stage_points: 10 },\\n        { driver_id: 4006, car_number: \'9\', stage_points: 7 },\\n        { driver_id: 5002, car_number: \'7\', stage_points: 8 },\\n      ],\\n    },\\n    {\\n      stage_num: 2,\\n      results: [\\n        { driver_id: 4001, car_number: simulateZilischInjury ? \'88\' : \'17\', stage_points: 9 },\\n        { driver_id: 4006, car_number: \'9\', stage_points: 7 },\\n      ],\\n    },\\n  ];\\n\\n  // 3. TRUCK SERIES (Friday)\\n  const trucksRaw: NascarFeedResult[] = [\\n    {\\n      driver_id: 4101,\\n      driver_fullname: \'Kyle Busch\',\\n      car_number: \'7\',\\n      team_name: \'Spire Motorsports\',\\n      finishing_position: 1,\\n      points_earned: 0, // BUSCHWHACKER: 0 Driver pts, 1st (55/40) + 18 Stage + 1 FL = 74/59 Owner Pts!\\n      fastest_lap: true,\\n    },\\n    { driver_id: 6001, driver_fullname: \'Corey Heim\', car_number: \'11\', team_name: \'TRICON Garage\', finishing_position: 2, points_earned: 48 },\\n    { driver_id: 6003, driver_fullname: \'Ty Majeski\', car_number: \'98\', team_name: \'ThorSport Racing\', finishing_position: 3, points_earned: 42 },\\n    { driver_id: 6004, driver_fullname: \'Grant Enfinger\', car_number: \'9\', team_name: \'CR7 Motorsports\', finishing_position: 5, points_earned: 35 },\\n    { driver_id: 6005, driver_fullname: \'Christian Eckes\', car_number: \'19\', team_name: \'McAnally-Hilgemann\', finishing_position: 7, points_earned: 31 },\\n    { driver_id: 6006, driver_fullname: \'Rajah Caruth\', car_number: \'71\', team_name: \'Spire Motorsports\', finishing_position: 11, points_earned: 26 },\\n    { driver_id: 6002, driver_fullname: \'Layne Riggs\', car_number: \'34\', team_name: \'Front Row Motorsports\', finishing_position: 15, points_earned: 22 },\\n  ];\\n\\n  const trucksStages: NascarStageFeed[] = [\\n    { stage_num: 1, results: [{ driver_id: 4101, car_number: \'7\', stage_points: 10 }] },\\n    { stage_num: 2, results: [{ driver_id: 4101, car_number: \'7\', stage_points: 8 }] },\\n  ];\\n\\n  return {\\n    1: processRaceResultsWithOwnerFallback(cupRaw, cupStages, firstPlacePoints),\\n    2: processRaceResultsWithOwnerFallback(oreillysRaw, oreillysStages, firstPlacePoints),\\n    3: processRaceResultsWithOwnerFallback(trucksRaw, trucksStages, firstPlacePoints),\\n  };\\n}\\n\\nexport async function syncRaceResultsToDatabase(\\n  firstPlacePoints: 55 | 40,\\n  simulateZilischInjury: boolean\\n) {\\n  try {\\n    const computedBySeries = buildWeekendSimulationFeeds(\\n      firstPlacePoints,\\n      simulateZilischInjury\\n    );\\n    const raceMap: Record<1 | 2 | 3, string> = {\\n      1: \'r_cup_bristol\',\\n      2: \'r_oreillys_bristol\',\\n      3: \'r_trucks_bristol\',\\n    };\\n\\n    const allDrivers = await db.select().from(drivers);\\n\\n    for (const sId of [1, 2, 3] as const) {\\n      const raceId = raceMap[sId];\\n      const results = computedBySeries[sId];\\n\\n      // Delete existing rows for this race so DNS/Injury simulation cleanly reflects\\n      await db\\n        .delete(raceDriverResults)\\n        .where(eq(raceDriverResults.raceId, raceId));\\n\\n      for (const r of results) {\\n        const matchedDriver = allDrivers.find(\\n          (d) => d.seriesId === sId && d.nascarDriverId === r.nascar_driver_id\\n        );\\n\\n        await db.insert(raceDriverResults).values({\\n          raceId,\\n          driverId: matchedDriver?.id ?? null,\\n          nascarDriverId: r.nascar_driver_id,\\n          driverFullname: r.driver_fullname,\\n          actualCarNumber: r.actual_car_number,\\n          actualTeamName: r.actual_team_name,\\n          finishPosition: r.finish_position,\\n          stagePoints: r.stage_points,\\n          fastestLapBonus: r.fastest_lap_bonus,\\n          driverPoints: r.driver_points,\\n          calculatedOwnerPoints: r.calculated_owner_points,\\n          effectiveFantasyPoints: r.effective_fantasy_points,\\n          scoringSource: r.scoring_source,\\n          isDisqualified: r.is_disqualified,\\n          updatedAt: new Date(),\\n        });\\n      }\\n\\n      await db\\n        .update(races)\\n        .set({ lastSyncedAt: new Date() })\\n        .where(eq(races.id, raceId));\\n    }\\n\\n    return computedBySeries;\\n  } catch (error) {\\n    console.error(\'Database error in syncRaceResultsToDatabase:\', error);\\n    throw new Error(\'Failed to persist race results to database.\', {\\n      cause: error,\\n    });\\n  }\\n}\\n\\nexport async function getFullLeagueState() {\\n  try {\\n    const [\\n      allUsers,\\n      allSeries,\\n      allDrivers,\\n      allRaces,\\n      allRosters,\\n      allPicks,\\n      allResults,\\n    ] = await Promise.all([\\n      db.select().from(users),\\n      db.select().from(seriesConfig),\\n      db.select().from(drivers),\\n      db.select().from(races),\\n      db.select().from(seasonRosters),\\n      db.select().from(weeklyPicks),\\n      db.select().from(raceDriverResults),\\n    ]);\\n\\n    // If race_driver_results is empty on first boot, populate it automatically\\n    let currentResults = allResults;\\n    if (currentResults.length === 0) {\\n      const cupSeries = allSeries.find((s) => s.id === 1);\\n      const fp = cupSeries?.firstPlacePoints === 40 ? 40 : 55;\\n      await syncRaceResultsToDatabase(fp, true);\\n      currentResults = await db.select().from(raceDriverResults);\\n    }\\n\\n    return {\\n      users: allUsers,\\n      seriesConfig: allSeries,\\n      drivers: allDrivers,\\n      races: allRaces,\\n      seasonRosters: allRosters,\\n      weeklyPicks: allPicks,\\n      raceDriverResults: currentResults,\\n    };\\n  } catch (error) {\\n    console.error(\'Database error in getFullLeagueState:\', error);\\n    throw new Error(\'Failed to load league state from database.\', {\\n      cause: error,\\n    });\\n  }\\n}\\n\\nexport async function saveWeeklyPick(params: {\\n  userId: string;\\n  raceId: string;\\n  seriesId: number;\\n  driverId: string;\\n}) {\\n  try {\\n    const { userId, raceId, seriesId, driverId } = params;\\n\\n    // Check race lock status\\n    const targetRace = await db\\n      .select()\\n      .from(races)\\n      .where(eq(races.id, raceId));\\n\\n    if (targetRace.length > 0 && targetRace[0].isLockedRevealed) {\\n      throw new Error(\'Race has already reached Green Flag lock.\');\\n    }\\n\\n    // Check driver usage bank limit\\n    const seriesRow = await db\\n      .select()\\n      .from(seriesConfig)\\n      .where(eq(seriesConfig.id, seriesId));\\n    const maxUses = seriesRow[0]?.maxWeeklyUsesPerDriver ?? 5;\\n\\n    const historicalUses = await db\\n      .select()\\n      .from(weeklyPicks)\\n      .where(\\n        and(\\n          eq(weeklyPicks.userId, userId),\\n          eq(weeklyPicks.driverId, driverId),\\n          eq(weeklyPicks.isHistorical, true)\\n        )\\n      );\\n\\n    if (historicalUses.length >= maxUses) {\\n      throw new Error(\\n        `Driver has 0/${maxUses} uses remaining in your Driver Usage Bank.`\\n      );\\n    }\\n\\n    const upserted = await db\\n      .insert(weeklyPicks)\\n      .values({\\n        userId,\\n        raceId,\\n        seriesId,\\n        driverId,\\n        trackLabel: targetRace[0]?.trackName || \'Bristol Night\',\\n        isHistorical: false,\\n        submittedAt: new Date(),\\n      })\\n      .onConflictDoUpdate({\\n        target: [weeklyPicks.userId, weeklyPicks.raceId],\\n        set: {\\n          driverId,\\n          submittedAt: new Date(),\\n        },\\n      })\\n      .returning();\\n\\n    return upserted[0];\\n  } catch (error) {\\n    console.error(\'Database error in saveWeeklyPick:\', error);\\n    throw new Error(\\n      error instanceof Error ? error.message : \'Failed to save weekly pick.\',\\n      { cause: error }\\n    );\\n  }\\n}\\n\\nexport async function updateSeasonRosterSlot(params: {\\n  userId: string;\\n  seriesId: number;\\n  slotType: string;\\n  driverId: string;\\n  fallbackCarNumber: string;\\n}) {\\n  try {\\n    const { userId, seriesId, slotType, driverId, fallbackCarNumber } = params;\\n\\n    // Enforce exclusive season driver rule across the league EXCEPT \'cup_current_chase\'\\n    if (slotType !== \'cup_current_chase\') {\\n      const existingOwner = await db\\n        .select()\\n        .from(seasonRosters)\\n        .where(\\n          and(\\n            eq(seasonRosters.seriesId, seriesId),\\n            eq(seasonRosters.driverId, driverId),\\n            ne(seasonRosters.slotType, \'cup_current_chase\'),\\n            ne(seasonRosters.userId, userId)\\n          )\\n        );\\n\\n      if (existingOwner.length > 0) {\\n        throw new Error(\\n          \'Exclusive Draft Rule: That driver is already locked on another manager\342\200\231s season-long roster.\'\\n        );\\n      }\\n    }\\n\\n    const updated = await db\\n      .insert(seasonRosters)\\n      .values({\\n        userId,\\n        seriesId,\\n        slotType,\\n        driverId,\\n        fallbackCarNumber: fallbackCarNumber.replace(\'#\', \'\').trim(),\\n      })\\n      .onConflictDoUpdate({\\n        target: [seasonRosters.userId, seasonRosters.slotType],\\n        set: {\\n          driverId,\\n          fallbackCarNumber: fallbackCarNumber.replace(\'#\', \'\').trim(),\\n        },\\n      })\\n      .returning();\\n\\n    return updated[0];\\n  } catch (error) {\\n    console.error(\'Database error in updateSeasonRosterSlot:\', error);\\n    throw new Error(\\n      error instanceof Error ? error.message : \'Failed to update season roster.\',\\n      { cause: error }\\n    );\\n  }\\n}\\n\\nexport async function updateLeagueAdminSettings(params: {\\n  firstPlacePoints?: 55 | 40;\\n  useCarAnchorFallback?: boolean;\\n  chaseActive?: boolean;\\n  simulateZilischInjury?: boolean;\\n  raceLocks?: Record<number, boolean>;\\n  activeSeriesWeekend?: Record<number, boolean>;\\n}) {\\n  try {\\n    const currentSeries = await db.select().from(seriesConfig);\\n    const cupCfg = currentSeries.find((s) => s.id === 1);\\n\\n    const nextFirstPlace: 55 | 40 =\\n      params.firstPlacePoints ?? (cupCfg?.firstPlacePoints === 40 ? 40 : 55);\\n    const nextCarAnchor =\\n      params.useCarAnchorFallback ?? cupCfg?.useCarAnchorFallback ?? true;\\n    const nextChaseActive = params.chaseActive ?? cupCfg?.chaseActive ?? true;\\n\\n    for (const sId of [1, 2, 3]) {\\n      await db\\n        .update(seriesConfig)\\n        .set({\\n          firstPlacePoints: nextFirstPlace,\\n          useCarAnchorFallback: nextCarAnchor,\\n          chaseActive: nextChaseActive,\\n        })\\n        .where(eq(seriesConfig.id, sId));\\n    }\\n\\n    const raceMap: Record<number, string> = {\\n      1: \'r_cup_bristol\',\\n      2: \'r_oreillys_bristol\',\\n      3: \'r_trucks_bristol\',\\n    };\\n\\n    if (params.raceLocks) {\\n      for (const [sIdStr, locked] of Object.entries(params.raceLocks)) {\\n        const rId = raceMap[Number(sIdStr)];\\n        if (rId) {\\n          await db\\n            .update(races)\\n            .set({\\n              isLockedRevealed: Boolean(locked),\\n              syncStatus: locked ? \'live\' : \'upcoming\',\\n            })\\n            .where(eq(races.id, rId));\\n        }\\n      }\\n    }\\n\\n    if (params.activeSeriesWeekend) {\\n      for (const [sIdStr, isActive] of Object.entries(\\n        params.activeSeriesWeekend\\n      )) {\\n        const rId = raceMap[Number(sIdStr)];\\n        if (rId) {\\n          await db\\n            .update(races)\\n            .set({ isActiveWeekend: Boolean(isActive) })\\n            .where(eq(races.id, rId));\\n        }\\n      }\\n    }\\n\\n    const simZilisch =\\n      params.simulateZilischInjury !== undefined\\n        ? params.simulateZilischInjury\\n        : true;\\n\\n    await syncRaceResultsToDatabase(nextFirstPlace, simZilisch);\\n    return await getFullLeagueState();\\n  } catch (error) {\\n    console.error(\'Database error in updateLeagueAdminSettings:\', error);\\n    throw new Error(\'Failed to update league admin settings.\', {\\n      cause: error,\\n    });\\n  }\\n}\\n\", \"Description\":\"Create type-safe Drizzle repository layer with two-layer error handling in src/db/repository.ts\", \"Overwrite\":true, \"TargetFile\":\"/src/db/repository.ts\", \"toolAction\":\"Creating Drizzle database repository\", \"toolSummary\":\"Create Drizzle database repository\"}"
      thinking_signature: "\022\300\032\n\275\032\001i\024}\023\252\206\2406K\357\a\233*\000\306\323\366\322\030\227h\215\245\3235|\a\3746UaG\374K\251\243\350\326\21287\360\356BZ\016\367\232\266\023\245P+B\250\246+\242f\2071\266K\006\245ati\344t6\nd\244\236\0325\241\317t\353\177k\200\263\352W\261\321\3740J4O\'\327\346\034\365-%-P\342\3324\266\200\323\227\230Evr\266\223\026\260\310\035\035`\207\365\025\250z\357\t\246Y\220\3116\325\331\212\314\340\210z \251\203=\241,\252/\f*\3602\201\224\r)c\356\306$\211d~\227\270\242\200\355ni\322$S9\r\237K\374Y7M\004\255l\210\242\216\025\356E\205<\201\335\204\005\367\205\213|\231 \"\3374{\214d\001Q\035Ni\364\311\313FN\210D\002\242\264\353I\221\242\200~\033\316\350h\361\346O!\361_>\221\227:mY\212{w6|e7\207(\020D\\>\352c.r.Ue\252\363\253qn0:/N\025\237\377\324\277C?\036c\276\361t~\236]\204\277\277\232\221\222)\350\033]\200\302\231\217+\024\273\211\024I\rf\250\344\371\210e\262\354\212F\303[E&\251\032\200:\330\241\035l\251\214+\272\274\242\207\266\373\212G\320\332\237ZF\213<\001\235\341!\325<\213W\225\177\351\240\033\277\"Z\000pI\246xf\223?c\272\364\207\307,\250\214\377l\270\200\240\227\247\310G9\354\300\276b!c-\257$\002\223D\243\354\350\363\273\217b\271\313\201\303\336\225\235\237#\363\016K\214\316B.1\344\237Bc\037<\376Z)\202L>1\236\221\257?\3729\ti\201\245A\260\255\v\376m\267\337\031\365\346\211\201\034\2218\354\373\216\230R\037&GS4\227\375w[G\365\r\3022\"\356\323\226\024(A\200\257\033,Bv\273\023 o\322a{\0172\021\032\277b\274\253\243\247\261-\317oMe{\250k?*1\2650\016O\301\025@m}\376\3374\255]\360\320\354\373\200\217\247\315\273r\245\213\023]\277%kbaA\f\222>\017I\3769\342\363\374L\257U\351X\326\004\261@\300\316\f\025gJ<Y\210\363h\376\361p\021!u\215\223,\236J1\244\306\373y\t\360\347\025-\341|g\333+=w\226\276\347\324t\331:\361vw\326\256\255q\006q\361y\001\306\v\311$G\344\245e\177\246\257\3555\202\217\035\303]\213%\204\362\233\225\025\321Lu\370\341\214\330\324\311glt\204\211t\317e\237\307x\2310{\275gD+\346\016\226\252\337\353+\200\241t\240\032[\356\255\234\332\205\"<Pmi\232\235\223\246\034\317\374\243\020u\023\362\030}S\250[\347\035\274R\341\036\276\207\234\214\252\260\3737\307p\254r)\005\vb\035\vx\266c\215)3\005:T\003-\267\250\034\2242b\247\260\221\234\346\267\254\021\2022c\005\355\220<!*\3567p\305\361w\3607\1772e]2\005T\252h\021M\261\003\354\202\217\3054/\211\f! \b\253\304)\314\215\247l\335\246\214B\335\267\344\242\305\326\317\370\\p~\031\027\242\311z\205\323\211\024\f\3142\\\024\254\335\ahc)\261\030\2415\367\241=\276\246\353\234\314\303\215\250\314jYQ3\371\221\352\322\373\256e\363p\006=\f(\031h\005\321\f\376#U]E\304Q5\330]^\240`\226\261ufcR,\304\305\356 \256\375d\203F\240\235\361\207\377\347\211[pd)\250\2703\243sj\205\004Q\002W\250\t*\237\355k\a~\357\277+\304\211$\212\360\3617\311\270\332\026\321\207\002\237w\244\225\301\001\3744S-\211\366BU\033\032\001\317\301\301;B<dK\033\222\265\336\340\230z\031\246.\f\340z\\\241\205\376vq\310\304\364\224\327\002\317\v\206au\331f\tj\340\222\251\272a\022\207\310h-R}&\255\222\242w\367\247\304\254\324\232\017s\300\352s\314\260Cg\351\f\000\207gr\226\273\323CDs\227W\354in\375.\275\271\306\266\305\331\320\366\022\346\256o \205\364\300\376\\\261\265\265u\016\355\262\220\2012\024\\\261^\242\325\361\337!\266\372J\351\302\215{\277\264\034\337\033\305\322A\344?\240\240\251\235#\261)\002?\024\266\311\376;1\323\n\237\240\347\202C\027\345y\"[\250\252\225\3326Rj0\356\200Z\344\004y\277\207\362\254\312\277W\231ZVr\234\206\031E\365\030\t\213\206\302L&\377\272\0242\n\222\315\321\";\364\"\270\272\366\304\230\335\263f\256z\037\003\024\2450\322\223eZ\342\201\303\233\216q\027uA\265\027\261\027|\351r\371C\271P?=P\337\226z\002\360\r<B5\325\375xa\344\204xV\023\3754\v4\350h\005\0374\364\213\025\262\247\264l\306\273\272\034pE~R^\307f\344\322\315\333\342\215\317\2233\331\363s\265A\220^>^(\021\312\350y\0200\377\262\351\375\r\215\372`lZ\026\211\006\276n\265\220l\340\362\256\027\232\263sW\230\346O\212\347\361YzO\353\027/\332\r\207v\370\345\213Q%|\370\243\212\202a\231\355\325\261\263\373\307r\344Y\376\a\235TI\371\000\363G8\216S\216m\217\022\250\266\265SlsV{\315\020\277\204N\n\206\2435\ty{M\350\035\362j\272\265\360\ne\320Y\254\001\002\335\243\313\363 \312\220/\250\261\250\314\335n\366A\020\372\226o\276a\237e\206\267\003v\033\201\337\354\367\354\234m\207\203<\2474\366e\267*v.[\030\322\220\002\026\000B\001\304Jz\222_\267{\r\316\235\a\376\006z\350\177\307\022Jd\3037\032\232\250U\000\250s\250\221U(\366\322S\310s\345hr\255\242\023\0230\'\274e\022Q\'sca6\277\251\306EA\324Ce/v\"\303\260\242\3602\'\004a\\~\333\305zN\250e\354\333y\003`oV\261\202L\334\332\226\006\035rb\251\022\027\305\337\333\365>\244\000/8J\252\364\271^\240\236\257D\256M3u\"\263A\335\322\206\331K\024ZU\301\350\273p\374\264\rJ\365D\030\261V\306\374\236\252\226\377Yv{\350\3737\254\0231\021<\313\200\037\322h{j\257\311\314\362\316\225\324g\222\244[\006A\2505\255\311e>S\241E\313/7\367P\324\210\317\230\253[\255\035\376\025q\245\235]\255\021\263\332\225\210\034\352\247v#t\300\"\257\341\265\0249\024EvE$%\361\001@9\310\244ctY\341\213\343^\347g\222\252y\273\212{/k\032 .6\201\030\224\244mc\276\263S\020\334F\210\347\317\324*5\272\266\366.;\265-F\325\\p\002\035G$L?d\177O\326\a8\2711g\367~\341@o\246\220\v\3743H\213.q\201O\3309\256\266&\313\220\025\202\\\022\274\240#Au\242\365\275\370~\301\002w\313(2\t\v\265\244L\\\023\b\361\302F\210\377\017\263\351\252\275\307\313\226\221\237\221#t 1\213\243\207\2330W\261\261W\373UeY\fS\271\245c\207\222\000\004\226\267\367\245~\211\243{\330xs%\313\313\325\244\r\2131Y\362ll\204\375\310\n\004\251&\252\236\264\327\3075}\364\247\256\244\bH3\273\355\2564\212y\261\323\0316\034\021?\32145C)\305~\201\326\233[\206.\tcZ\374\341\342\216h\346\242\261$\003\351Y\264U\357\355J\376\364\227V\f\244\301\335?R\371G\325O\363$\275\362Yv\362\323\225\275h\241\227\363\370=\242\221\240\374\311_*\332\375\231\3051\364\022\035\367\376\315\334L\3721ow\334\302\247\310\211P\341\225\260\352\251\204\230S|\311\316\037x\212\037\31131%9\371$\274>\262\322\307\206R\266x\270\300\233\336\026s_\3307\b|\271\001r\305n\207\335\f\217z.\3333$\344\321\\\277\v.\250=3=3\006\267w\030\366ep\021R\257\027\203\345\033\363A\336\216\367\320EYds@\004\031RDqx\"{\331_ %\332%65\267[\n3\230\216I\374\200\004\200*\236\254\000L\330\f\021\205\227\000\210\223f\347\330c\a\330\272X\203\345\242.\027\355\223t+j\343VZVkZ/\321\n\2034,Ly\346\272\315\327\021w\227_\217\b\330\n\260\332v*\312\254\357p\f\307\'\237\025c\311\217\002\233\270\255\232$|H\233\354S\231\f\373@\337#4\350\240\3402\225\337PK\351o\0264\357&\257\310b\vw&\301\272LZ\306\241\367\266\365\333\353\210\320\206\025\226n6\203J\202~[\220\3208\034\003\032\020\221\330>\003e\001O\371\217\226\025\204\304q@\227\314\312b)@\373\205\311\033\202\353\355-\037\301\245wp9E\252\v.\263Kf\232\214\201WTp\233\005\230:1\336\210n\306\234\234yZ\225\371aw\333\022F\345\316\352\257^\f\322\230[\260\210WC\215\335\024\303\bJ\233sd\221\n\221\271\372\365\371:\005\301\304{\247B|\302\\\360\347(1\001\307N$]H\365\312\201#\003sB\307\357\364\210cU\267\2011Q\255\331\022\321bwb\2276\001J\f\233\274\n\303\226\214<3\341\356H\365\023>\234\330\222\0022`g\2056\247\350\230N\022\300>\237\365\237\202\324\201_\242\354\216E\321\312p\027\362\377`\302\356\226\332\244\036\341\032\323\030nW\236)\315M\264w\307\377\273\204\"\025\031\033\315\337\265\024\337\021\226\221\266\036\330+\210`[\324x\311\362&\223Q|\232\250\346!\322\302z}ue\207sk\336\303\226\345\300x\315\300y$Z\254F]\356d\321B\244\342\202\344\262n\251\272W\r\0240\342b/\364-5L\221\236B\250\024\017\031\3319\202~d\203o\317\217\354n\242B\212\001.\247\260.\322\234\263\232\306\257\275\364V\037\261\004\203\002a\251\360\207(\365\370}\017\026\325~\347x\263\226\375\000U\314&\tS~>\25278i_*\rW\370\207\374f6X\213s\351\016u\200\352\337\b\333a\035\202\021\265\250\255\237\001\000\364\211\310q\240\256\r\222\246\206\331 \025b\rf\256\263%\301\344\006JN[|\214\300LwGP\253\251? Y\r[\321<\205j\355\341\311\374t\016\276\376\241\t\334-\360\235\324\252\201(\234+\220?\255^n\336A\351\326\206\3412\017[3\301S7\354\343\3425Z\331V\026\256Wh\321u\335\233\254sb\221\025\3412\362\343\022\322/\240Q\326\215\242\240\223\233\000\023M\333Ayd\bgg\n\302r\326|\363I\202\326/)G\274\024\201\355\247\"\275\266\211n\016\221a\2624<\027i+\n\025\361\375\276\261\322{\267\030\016\236\265\nb\302\n?\256E\266;\325Q\352\212\377\317*\215\247/\340\250o\006\262\006,\271](>\260}Le\353\324\303\304\023\352.\342\032}\005\223{\275\222PF,X\276\314\024\004!\240E\213\033@\251\342\262c\254\216a\213^i\321\232\335\310\265\303\200^w=\201w\214,7v\3757\200\217fP\365e\334\v3\336\004l\2105l\351;;?\3618^\367 \255E~\363x:\321FZ\205\ab\031\026\330y\370\356O\225$C\335\365_\330hN\263\301\263\247\020\250\205\303*\223$\310-r\205U\371{\"h\016\b\032xW\304\327\221\325\220\306S\262\223\306\362\033\004\313\350\002\023\361\372\246S\315J)=\204\333\3200\356\203\272\367:\231,D\0240\3428\233b\226\255\"\370P\356i\250gqs\004\2034\303\321\"\374\361U\332C\314\265\312\344\246G\327\177\277m\332\0317\240\262&N\v\315\250\374\264\261f5\365eL\216|Ls\253\032\vi\233\t\021\b\261\202<\"\356\343\313\356\206|\226\034\221\244\322h\312F8\326*A\271|\211\017u\274\313\363\250^\351s`\327d\220\211$+$\335\225\336\266Y\373\333o\333\006\226\233\330\036\004\320\237\2262\317k\332O\371\240kW]W\300\374\004a\r\310NvC\356\3208\"\327\302<\377\236\226Sl\317B\347\n\310\263\f\250\000\271\366\022%F\265G\215\354BL]0\251\020\337\265\"\2524\211\r\344,y^\303\005B\355\377\301\320\232\216\340P\231F\230D%\207\214\367{\236\230cT\314\272\312\316\272F\2724|\207\f\335\260g\006\267\025V\336\311\223\251\264\t=[W\002?\275\005\206\327\030F^\376llA\302\006\v\274W\247P\005\272W%1\205\312`\204}\345(\r\0369&\214\206\360\346g;\350kv\000\022\2251\245\353\235{t\303\025\213.\245\323#\327"
