    tool_calls {
      id: "call_8395968135005625911"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useEffect, useMemo, useRef } from \'react\';\\nimport {\\n  Trophy,\\n  Calendar,\\n  Database,\\n  Users,\\n  RefreshCw,\\n  Lock,\\n  Unlock,\\n  Sliders,\\n  Gauge,\\n  ArrowUpDown,\\n  LogIn,\\n  LogOut,\\n  Check,\\n  AlertCircle,\\n} from \'lucide-react\';\\nimport { signInWithPopup, signOut, onAuthStateChanged, User } from \'firebase/auth\';\\nimport { auth, googleAuthProvider } from \'./lib/firebase.ts\';\\nimport {\\n  resolveSeasonSlotScore,\\n  ComputedRaceResult,\\n} from \'./lib/nascar-scoring-engine.ts\';\\n\\ntype SeriesId = 1 | 2 | 3;\\n\\ninterface SeriesMeta {\\n  id: SeriesId;\\n  name: string;\\n  shortName: string;\\n  colorHex: string;\\n  textClass: string;\\n  borderSubtle: string;\\n  maxWeeklyUses: number;\\n}\\n\\nconst SERIES_META: Record<SeriesId, SeriesMeta> = {\\n  1: {\\n    id: 1,\\n    name: \'NASCAR Cup Series\',\\n    shortName: \'Cup Series\',\\n    colorHex: \'#F59E0B\',\\n    textClass: \'text-[#F59E0B]\',\\n    borderSubtle: \'border-amber-500/30\',\\n    maxWeeklyUses: 5,\\n  },\\n  2: {\\n    id: 2,\\n    name: \\\"NASCAR O\'Reilly\'s Series\\\",\\n    shortName: \\\"O\'Reilly\'s Series\\\",\\n    colorHex: \'#EF4444\',\\n    textClass: \'text-[#EF4444]\',\\n    borderSubtle: \'border-red-500/30\',\\n    maxWeeklyUses: 5,\\n  },\\n  3: {\\n    id: 3,\\n    name: \'NASCAR Craftsman Truck Series\',\\n    shortName: \'Truck Series\',\\n    colorHex: \'#3B82F6\',\\n    textClass: \'text-[#3B82F6]\',\\n    borderSubtle: \'border-blue-500/30\',\\n    maxWeeklyUses: 5,\\n  },\\n};\\n\\ninterface DbUser {\\n  id: string;\\n  uid: string;\\n  email: string;\\n  name: string;\\n  avatar: string;\\n  lastYearRank: number;\\n  role: string;\\n  cumulativePriorPoints: number;\\n}\\n\\ninterface DbSeriesConfig {\\n  id: number;\\n  name: string;\\n  shortName: string;\\n  badgeColor: string;\\n  maxWeeklyUsesPerDriver: number;\\n  chaseActive: boolean;\\n  firstPlacePoints: number;\\n  useCarAnchorFallback: boolean;\\n}\\n\\ninterface DbDriver {\\n  id: string;\\n  nascarDriverId: number;\\n  seriesId: number;\\n  carNumber: string;\\n  fullName: string;\\n  team: string;\\n  madeLastYearChase: boolean;\\n  inCurrentChase: boolean;\\n  isBuschwhacker: boolean;\\n  active: boolean;\\n}\\n\\ninterface DbRace {\\n  id: string;\\n  nascarRaceId: number;\\n  seriesId: number;\\n  weekendGroupId: string;\\n  raceName: string;\\n  trackName: string;\\n  raceStartTime: string;\\n  isChaseRace: boolean;\\n  isLockedRevealed: boolean;\\n  isActiveWeekend: boolean;\\n  syncStatus: string;\\n  lastSyncedAt: string | null;\\n}\\n\\ninterface DbSeasonRoster {\\n  id: number;\\n  userId: string;\\n  seriesId: number;\\n  slotType: string;\\n  driverId: string;\\n  fallbackCarNumber: string;\\n}\\n\\ninterface DbWeeklyPick {\\n  id: number;\\n  userId: string;\\n  raceId: string;\\n  seriesId: number;\\n  driverId: string;\\n  trackLabel: string | null;\\n  isHistorical: boolean;\\n  submittedAt: string;\\n}\\n\\ninterface DbRaceResult {\\n  id: number;\\n  raceId: string;\\n  driverId: string | null;\\n  nascarDriverId: number;\\n  driverFullname: string;\\n  actualCarNumber: string;\\n  actualTeamName: string;\\n  finishPosition: number;\\n  stagePoints: number;\\n  fastestLapBonus: number;\\n  driverPoints: number;\\n  calculatedOwnerPoints: number;\\n  effectiveFantasyPoints: number;\\n  scoringSource: \'OFFICIAL_DRIVER_PTS\' | \'BUSCHWHACKER_OWNER_PTS\' | \'DQ_PENALTY\';\\n  isDisqualified: boolean;\\n}\\n\\ninterface LeagueStatePayload {\\n  users: DbUser[];\\n  seriesConfig: DbSeriesConfig[];\\n  drivers: DbDriver[];\\n  races: DbRace[];\\n  seasonRosters: DbSeasonRoster[];\\n  weeklyPicks: DbWeeklyPick[];\\n  raceDriverResults: DbRaceResult[];\\n}\\n\\nconst EXTRA_USAGE_HISTORY: Record<string, string[]> = {\\n  c3: [\'Martinsville\'],\\n  cn1: [\'Talladega\', \'Dover\'],\\n  o_bw1: [\'Darlington\'],\\n  o1: [\'Watkins Glen\', \'Road America\'],\\n  t2: [\'Bristol Spring\', \'Martinsville\', \'North Wilkesboro\', \'Charlotte\'],\\n  t_bw1: [\'Atlanta\', \'Las Vegas\'],\\n};\\n\\nexport default function App() {\\n  const [activeTab, setActiveTab] = useState<\\n    \'picks\' | \'standings\' | \'bank\' | \'draft\' | \'admin\'\\n  >(\'picks\');\\n\\n  // Firebase Auth state (Token stored strictly in memory per security guidelines)\\n  const [firebaseUser, setFirebaseUser] = useState<User | null>(null);\\n  const idTokenRef = useRef<string | null>(null);\\n  const [activeManagerId, setActiveManagerId] = useState<string>(\'u1\');\\n\\n  // League State from Backend API\\n  const [leagueState, setLeagueState] = useState<LeagueStatePayload | null>(\\n    null\\n  );\\n  const [isLoading, setIsLoading] = useState<boolean>(true);\\n  const [statusBanner, setStatusBanner] = useState<{\\n    type: \'info\' | \'error\' | \'success\';\\n    text: string;\\n  } | null>(null);\\n\\n  // Sync & Simulation State\\n  const [isSyncing, setIsSyncing] = useState<boolean>(false);\\n  const [lastSyncedAt, setLastSyncedAt] = useState<string>(\'Just now\');\\n  const [simulateZilischInjury, setSimulateZilischInjury] =\\n    useState<boolean>(true);\\n  const [cdnSchedulesSummary, setCdnSchedulesSummary] = useState<{\\n    cup: number;\\n    oreillys: number;\\n    trucks: number;\\n  }>({ cup: 36, oreillys: 33, trucks: 25 });\\n\\n  // Filter & Draft View States\\n  const [bankSeriesFilter, setBankSeriesFilter] = useState<SeriesId>(1);\\n  const [standingsViewFilter, setStandingsViewFilter] = useState<\\n    \'all\' | \'weekly_only\' | \'season_only\'\\n  >(\'all\');\\n  const [draftOrderMode, setDraftOrderMode] = useState<\\n    \'reverse_standings\' | \'random\'\\n  >(\'reverse_standings\');\\n\\n  // Fetch initial state\\n  useEffect(() => {\\n    let mounted = true;\\n    async function loadInitial() {\\n      try {\\n        const res = await fetch(\'/api/league-state\');\\n        const data = await res.json();\\n        if (mounted && data.ok && data.state) {\\n          setLeagueState(data.state);\\n          const oreillysResults: DbRaceResult[] =\\n            data.state.raceDriverResults || [];\\n          const zilischPresent = oreillysResults.some(\\n            (r) => r.raceId === \'r_oreillys_bristol\' && r.nascarDriverId === 5001\\n          );\\n          setSimulateZilischInjury(!zilischPresent);\\n        }\\n      } catch (err) {\\n        console.error(\'Failed to load initial state:\', err);\\n      } finally {\\n        if (mounted) setIsLoading(false);\\n      }\\n    }\\n    loadInitial();\\n    return () => {\\n      mounted = false;\\n    };\\n  }, []);\\n\\n  // Listen to Firebase Auth state and sync user to backend\\n  useEffect(() => {\\n    const unsubscribe = onAuthStateChanged(auth, async (user) => {\\n      setFirebaseUser(user);\\n      if (user) {\\n        try {\\n          const token = await user.getIdToken();\\n          idTokenRef.current = token;\\n          const res = await fetch(\'/api/auth/sync\', {\\n            method: \'POST\',\\n            headers: {\\n              \'Content-Type\': \'application/json\',\\n              Authorization: `Bearer ${token}`,\\n            },\\n          });\\n          const data = await res.json();\\n          if (data.ok && data.state) {\\n            setLeagueState(data.state);\\n            if (data.user?.id) {\\n              setActiveManagerId(data.user.id);\\n            }\\n          }\\n        } catch (err) {\\n          console.error(\'Auth sync error:\', err);\\n        }\\n      } else {\\n        idTokenRef.current = null;\\n      }\\n    });\\n    return () => unsubscribe();\\n  }, []);\\n\\n  const handleGoogleSignIn = async () => {\\n    try {\\n      await signInWithPopup(auth, googleAuthProvider);\\n      setStatusBanner({\\n        type: \'success\',\\n        text: \'Signed in with Google and linked to your Pit Box Fantasy roster.\',\\n      });\\n    } catch (error: any) {\\n      setStatusBanner({\\n        type: \'error\',\\n        text: error?.message || \'Sign-in cancelled or failed.\',\\n      });\\n    }\\n  };\\n\\n  const handleSignOut = async () => {\\n    await signOut(auth);\\n    idTokenRef.current = null;\\n    setActiveManagerId(\'u1\');\\n  };\\n\\n  // Derived Configuration from League State\\n  const cupConfig = useMemo(\\n    () => leagueState?.seriesConfig.find((s) => s.id === 1),\\n    [leagueState]\\n  );\\n  const firstPlacePoints: 55 | 40 =\\n    cupConfig?.firstPlacePoints === 40 ? 40 : 55;\\n  const useCarAnchorFallback: boolean =\\n    cupConfig?.useCarAnchorFallback ?? true;\\n  const midSeasonChaseActive: boolean = cupConfig?.chaseActive ?? true;\\n\\n  const weekendRacesBySeries = useMemo(() => {\\n    const map: Record<SeriesId, DbRace | undefined> = {\\n      1: undefined,\\n      2: undefined,\\n      3: undefined,\\n    };\\n    for (const r of leagueState?.races || []) {\\n      if (r.id === \'r_cup_bristol\') map[1] = r;\\n      if (r.id === \'r_oreillys_bristol\') map[2] = r;\\n      if (r.id === \'r_trucks_bristol\') map[3] = r;\\n    }\\n    return map;\\n  }, [leagueState]);\\n\\n  const computedWeekendResults = useMemo(() => {\\n    const grouped: Record<SeriesId, ComputedRaceResult[]> = {\\n      1: [],\\n      2: [],\\n      3: [],\\n    };\\n    const raceToSeries: Record<string, SeriesId> = {\\n      r_cup_bristol: 1,\\n      r_oreillys_bristol: 2,\\n      r_trucks_bristol: 3,\\n    };\\n\\n    for (const row of leagueState?.raceDriverResults || []) {\\n      const sId = raceToSeries[row.raceId];\\n      if (sId) {\\n        grouped[sId].push({\\n          nascar_driver_id: row.nascarDriverId,\\n          driver_fullname: row.driverFullname,\\n          actual_car_number: row.actualCarNumber,\\n          actual_team_name: row.actualTeamName,\\n          finish_position: row.finishPosition,\\n          stage_points: row.stagePoints,\\n          fastest_lap_bonus: row.fastestLapBonus,\\n          driver_points: row.driverPoints,\\n          calculated_owner_points: row.calculatedOwnerPoints,\\n          effective_fantasy_points: row.effectiveFantasyPoints,\\n          is_disqualified: row.isDisqualified,\\n          scoring_source: row.scoringSource,\\n        });\\n      }\\n    }\\n    grouped[1].sort((a, b) => a.finish_position - b.finish_position);\\n    grouped[2].sort((a, b) => a.finish_position - b.finish_position);\\n    grouped[3].sort((a, b) => a.finish_position - b.finish_position);\\n    return grouped;\\n  }, [leagueState]);\\n\\n  // Calculate Usage Bank for Active Manager\\n  const getDriverRemainingUses = (driverId: string, seriesId: SeriesId) => {\\n    const dbHistorical = (leagueState?.weeklyPicks || [])\\n      .filter(\\n        (p) =>\\n          p.userId === activeManagerId &&\\n          p.driverId === driverId &&\\n          p.isHistorical\\n      )\\n      .map((p) => p.trackLabel || \'Prior Race\');\\n\\n    const extraTracks = EXTRA_USAGE_HISTORY[driverId] || [];\\n    const combinedTracks =\\n      dbHistorical.length > 0 ? dbHistorical : extraTracks;\\n\\n    const seriesCfg = leagueState?.seriesConfig.find((s) => s.id === seriesId);\\n    const maxUses = seriesCfg?.maxWeeklyUsesPerDriver ?? 5;\\n\\n    const activeRaceId = weekendRacesBySeries[seriesId]?.id;\\n    const isCurrentlyPicked = (leagueState?.weeklyPicks || []).some(\\n      (p) =>\\n        p.userId === activeManagerId &&\\n        p.raceId === activeRaceId &&\\n        p.driverId === driverId &&\\n        !p.isHistorical\\n    );\\n\\n    return {\\n      pastTracks: combinedTracks,\\n      used: combinedTracks.length,\\n      isCurrentlyPicked,\\n      remaining: Math.max(0, maxUses - combinedTracks.length),\\n      maxUses,\\n    };\\n  };\\n\\n  // Automatic Points Distribution & Standings Math\\n  const leaderboard = useMemo(() => {\\n    if (!leagueState) return [];\\n    const allDrivers = leagueState.drivers;\\n    const allRosters = leagueState.seasonRosters;\\n    const allPicks = leagueState.weeklyPicks;\\n\\n    return leagueState.users\\n      .map((member) => {\\n        const getDriverObj = (dId: string) =>\\n          allDrivers.find((d) => d.id === dId);\\n\\n        const calcWeeklyPick = (seriesId: SeriesId) => {\\n          const raceObj = weekendRacesBySeries[seriesId];\\n          if (!raceObj || !raceObj.isActiveWeekend) {\\n            return {\\n              points: 0,\\n              label: \'Series Off-Week\',\\n              isOwnerPts: false,\\n              carNumber: \'-\',\\n              driverId: \'\',\\n            };\\n          }\\n\\n          const pickRow = allPicks.find(\\n            (p) =>\\n              p.userId === member.id &&\\n              p.raceId === raceObj.id &&\\n              !p.isHistorical\\n          );\\n          const driverObj = pickRow ? getDriverObj(pickRow.driverId) : undefined;\\n          if (!driverObj) {\\n            return {\\n              points: 0,\\n              label: \'Waiting on Pick\',\\n              isOwnerPts: false,\\n              carNumber: \'-\',\\n              driverId: \'\',\\n            };\\n          }\\n\\n          const result = computedWeekendResults[seriesId].find(\\n            (r) => r.nascar_driver_id === driverObj.nascarDriverId\\n          );\\n\\n          if (!result) {\\n            return {\\n              points: 0,\\n              label: `${driverObj.fullName} (#${driverObj.carNumber}) \302\267 0 Pts`,\\n              isOwnerPts: false,\\n              carNumber: driverObj.carNumber,\\n              driverId: driverObj.id,\\n            };\\n          }\\n\\n          const isOwnerPts =\\n            result.scoring_source === \'BUSCHWHACKER_OWNER_PTS\';\\n          return {\\n            points: result.effective_fantasy_points,\\n            label: `${result.driver_fullname} (#${result.actual_car_number} ${result.actual_team_name}) \302\267 ${result.effective_fantasy_points} ${\\n              isOwnerPts ? \'Owner Pts\' : \'Pts\'\\n            }`,\\n            isOwnerPts,\\n            carNumber: result.actual_car_number,\\n            driverId: driverObj.id,\\n          };\\n        };\\n\\n        const calcSeasonSlot = (seriesId: SeriesId, slotType: string) => {\\n          const raceObj = weekendRacesBySeries[seriesId];\\n          if (!raceObj || !raceObj.isActiveWeekend) {\\n            return {\\n              points: 0,\\n              badgeText: \'Series Off-Week\',\\n              usedCarAnchor: false,\\n              slotRow: undefined,\\n            };\\n          }\\n          const slotRow = allRosters.find(\\n            (r) => r.userId === member.id && r.slotType === slotType\\n          );\\n          if (!slotRow) {\\n            return {\\n              points: 0,\\n              badgeText: \'Unassigned\',\\n              usedCarAnchor: false,\\n              slotRow: undefined,\\n            };\\n          }\\n          const driverObj = getDriverObj(slotRow.driverId);\\n          if (!driverObj) {\\n            return {\\n              points: 0,\\n              badgeText: \'Unassigned\',\\n              usedCarAnchor: false,\\n              slotRow,\\n            };\\n          }\\n\\n          const resolved = resolveSeasonSlotScore({\\n            primaryNascarDriverId: driverObj.nascarDriverId,\\n            fallbackCarNumber: slotRow.fallbackCarNumber,\\n            useCarAnchorFallback,\\n            raceResults: computedWeekendResults[seriesId],\\n          });\\n\\n          return {\\n            ...resolved,\\n            slotRow,\\n          };\\n        };\\n\\n        const cupWeekly = calcWeeklyPick(1);\\n        const cupSeasonChase = calcSeasonSlot(1, \'cup_prev_chase\');\\n        const cupSeasonNonChase = calcSeasonSlot(1, \'cup_prev_non_chase\');\\n        const cupMidSeasonBonus = midSeasonChaseActive\\n          ? calcSeasonSlot(1, \'cup_current_chase\')\\n          : {\\n              points: 0,\\n              badgeText: \'Chase Slot Locked\',\\n              usedCarAnchor: false,\\n              slotRow: undefined,\\n            };\\n\\n        const cupTotal =\\n          cupWeekly.points +\\n          cupSeasonChase.points +\\n          cupSeasonNonChase.points +\\n          cupMidSeasonBonus.points;\\n\\n        const oreillysWeekly = calcWeeklyPick(2);\\n        const oreillysSeason = calcSeasonSlot(2, \'oreillys_season\');\\n        const oreillysTotal = oreillysWeekly.points + oreillysSeason.points;\\n\\n        const trucksWeekly = calcWeeklyPick(3);\\n        const trucksSeason = calcSeasonSlot(3, \'trucks_season\');\\n        const trucksTotal = trucksWeekly.points + trucksSeason.points;\\n\\n        const weeklyOnlyWeekendTotal =\\n          cupWeekly.points + oreillysWeekly.points + trucksWeekly.points;\\n        const seasonOnlyWeekendTotal =\\n          cupSeasonChase.points +\\n          cupSeasonNonChase.points +\\n          cupMidSeasonBonus.points +\\n          oreillysSeason.points +\\n          trucksSeason.points;\\n\\n        const weekendTotal = cupTotal + oreillysTotal + trucksTotal;\\n        const grandTotal = member.cumulativePriorPoints + weekendTotal;\\n\\n        return {\\n          ...member,\\n          breakdown: {\\n            cupWeekly,\\n            cupSeasonChase,\\n            cupSeasonNonChase,\\n            cupMidSeasonBonus,\\n            cupTotal,\\n            oreillysWeekly,\\n            oreillysSeason,\\n            oreillysTotal,\\n            trucksWeekly,\\n            trucksSeason,\\n            trucksTotal,\\n            weeklyOnlyWeekendTotal,\\n            seasonOnlyWeekendTotal,\\n            weekendTotal,\\n            grandTotal,\\n          },\\n        };\\n      })\\n      .sort((a, b) => {\\n        if (standingsViewFilter === \'weekly_only\') {\\n          return (\\n            b.breakdown.weeklyOnlyWeekendTotal -\\n            a.breakdown.weeklyOnlyWeekendTotal\\n          );\\n        }\\n        if (standingsViewFilter === \'season_only\') {\\n          return (\\n            b.breakdown.seasonOnlyWeekendTotal -\\n            a.breakdown.seasonOnlyWeekendTotal\\n          );\\n        }\\n        return b.breakdown.grandTotal - a.breakdown.grandTotal;\\n      });\\n  }, [\\n    leagueState,\\n    weekendRacesBySeries,\\n    computedWeekendResults,\\n    useCarAnchorFallback,\\n    midSeasonChaseActive,\\n    standingsViewFilter,\\n  ]);\\n\\n  // Actions\\n  const handleManualSync = async () => {\\n    setIsSyncing(true);\\n    setStatusBanner({\\n      type: \'info\',\\n      text: \'Polling cf.nascar.com schedule, live_points.json & weekend-feed.json...\',\\n    });\\n    try {\\n      const res = await fetch(\'/api/nascar-sync\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          year: 2025,\\n          firstPlacePoints,\\n          simulateZilischInjury,\\n        }),\\n      });\\n      const data = await res.json();\\n      if (data.ok) {\\n        if (data.state) setLeagueState(data.state);\\n        if (data.schedules_found) setCdnSchedulesSummary(data.schedules_found);\\n        const nowStr = new Date().toLocaleTimeString([], {\\n          hour: \'2-digit\',\\n          minute: \'2-digit\',\\n          second: \'2-digit\',\\n        });\\n        setLastSyncedAt(nowStr);\\n        setStatusBanner({\\n          type: \'success\',\\n          text: `Synced cf.nascar.com feeds (${data.schedules_found?.cup || 36} Cup \302\267 ${\\n            data.schedules_found?.oreillys || 33\\n          } O\'Reilly\'s \302\267 ${\\n            data.schedules_found?.trucks || 25\\n          } Truck races) and recalculated Buschwhacker Owner Points.`,\\n        });\\n      }\\n    } catch (error: any) {\\n      setStatusBanner({\\n        type: \'error\',\\n        text: error?.message || \'Failed to sync NASCAR feed.\',\\n      });\\n    } finally {\\n      setIsSyncing(false);\\n    }\\n  };\\n\\n  const handleSelectWeeklyPick = async (\\n    seriesId: SeriesId,\\n    driverId: string\\n  ) => {\\n    const raceObj = weekendRacesBySeries[seriesId];\\n    if (!raceObj) return;\\n    try {\\n      const res = await fetch(\'/api/weekly-pick\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          userId: activeManagerId,\\n          raceId: raceObj.id,\\n          seriesId,\\n          driverId,\\n        }),\\n      });\\n      const data = await res.json();\\n      if (data.ok && data.state) {\\n        setLeagueState(data.state);\\n        setStatusBanner({\\n          type: \'success\',\\n          text: `Weekly ${SERIES_META[seriesId].shortName} pick saved and locked in blind mode.`,\\n        });\\n      } else {\\n        setStatusBanner({\\n          type: \'error\',\\n          text: data.error || \'Could not update weekly pick.\',\\n        });\\n      }\\n    } catch (error: any) {\\n      setStatusBanner({\\n        type: \'error\',\\n        text: error?.message || \'Could not update weekly pick.\',\\n      });\\n    }\\n  };\\n\\n  const handleUpdateAdminSetting = async (patch: {\\n    firstPlacePoints?: 55 | 40;\\n    useCarAnchorFallback?: boolean;\\n    chaseActive?: boolean;\\n    simulateZilischInjury?: boolean;\\n    raceLocks?: Record<number, boolean>;\\n    activeSeriesWeekend?: Record<number, boolean>;\\n  }) => {\\n    if (patch.simulateZilischInjury !== undefined) {\\n      setSimulateZilischInjury(patch.simulateZilischInjury);\\n    }\\n    try {\\n      const res = await fetch(\'/api/admin/settings\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          firstPlacePoints,\\n          useCarAnchorFallback,\\n          chaseActive: midSeasonChaseActive,\\n          simulateZilischInjury,\\n          ...patch,\\n        }),\\n      });\\n      const data = await res.json();\\n      if (data.ok && data.state) {\\n        setLeagueState(data.state);\\n      }\\n    } catch (err) {\\n      console.error(\'Failed to update setting:\', err);\\n    }\\n  };\\n\\n  const handleUpdateSeasonSlot = async (\\n    seriesId: number,\\n    slotType: string,\\n    driverId: string,\\n    fallbackCarNumber: string\\n  ) => {\\n    try {\\n      const res = await fetch(\'/api/season-roster\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          userId: activeManagerId,\\n          seriesId,\\n          slotType,\\n          driverId,\\n          fallbackCarNumber,\\n        }),\\n      });\\n      const data = await res.json();\\n      if (data.ok && data.state) {\\n        setLeagueState(data.state);\\n        setStatusBanner({\\n          type: \'success\',\\n          text: \'Season roster slot and Car Anchor updated.\',\\n        });\\n      } else {\\n        setStatusBanner({\\n          type: \'error\',\\n          text: data.error || \'Exclusive Draft constraint prevented change.\',\\n        });\\n      }\\n    } catch (err: any) {\\n      setStatusBanner({\\n        type: \'error\',\\n        text: err?.message || \'Failed to update season roster.\',\\n      });\\n    }\\n  };\\n\\n  const sortedDraftOrder = useMemo(() => {\\n    const list = [...(leagueState?.users || [])];\\n    if (draftOrderMode === \'reverse_standings\') {\\n      return list.sort((a, b) => b.lastYearRank - a.lastYearRank);\\n    }\\n    return [list[3], list[0], list[5], list[1], list[4], list[2]].filter(\\n      Boolean\\n    );\\n  }, [leagueState, draftOrderMode]);\\n\\n  if (isLoading) {\\n    return (\\n      <div className=\\\"min-h-screen bg-[#0B0D10] text-white flex items-center justify-center p-6\\\">\\n        <div className=\\\"max-w-md w-full bg-[#161920] border border-slate-800 rounded-2xl p-6 space-y-4\\\">\\n          <div className=\\\"h-6 w-48 bg-slate-800 rounded animate-pulse\\\" />\\n          <div className=\\\"h-4 w-full bg-slate-800/70 rounded animate-pulse\\\" />\\n          <div className=\\\"h-24 w-full bg-slate-800/50 rounded-xl animate-pulse\\\" />\\n        </div>\\n      </div>\\n    );\\n  }\\n\\n  const activeUserRow = leaderboard.find((u) => u.id === activeManagerId);\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-[#0B0D10] text-white flex flex-col md:flex-row selection:bg-amber-500 selection:text-black\\\">\\n      {/* DESKTOP SIDEBAR NAVIGATION */}\\n      <aside className=\\\"hidden md:flex md:w-64 md:flex-col md:fixed md:inset-y-0 bg-[#12151B] border-r border-slate-800/80 z-30\\\">\\n        <div className=\\\"px-6 py-5 border-b border-slate-800/80 flex items-center gap-3\\\">\\n          <div className=\\\"w-9 h-9 rounded-lg bg-amber-500 flex items-center justify-center shrink-0\\\">\\n            <Gauge className=\\\"w-5 h-5 text-black stroke-[2.5]\\\" />\\n          </div>\\n          <span className=\\\"font-display font-bold tracking-wide text-2xl text-white whitespace-nowrap shrink-0\\\">\\n            PIT BOX FANTASY\\n          </span>\\n        </div>\\n\\n        <nav className=\\\"flex-1 p-3 space-y-1\\\">\\n          {[\\n            { id: \'picks\', label: \'Weekly Picks\', icon: Calendar },\\n            { id: \'standings\', label: \'Live Standings\', icon: Trophy },\\n            { id: \'bank\', label: \'Driver Bank\', icon: Database },\\n            { id: \'draft\', label: \'Draft & Season Roster\', icon: Users },\\n            { id: \'admin\', label: \'Sync Status / Admin\', icon: Sliders },\\n          ].map((item) => {\\n            const Icon = item.icon;\\n            const active = activeTab === item.id;\\n            return (\\n              <button\\n                key={item.id}\\n                onClick={() => setActiveTab(item.id as any)}\\n                className={`w-full min-h-[44px] flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition-colors cursor-pointer whitespace-nowrap shrink-0 ${\\n                  active\\n                    ? \'bg-[#161920] text-amber-400 border border-slate-700/80\'\\n                    : \'text-slate-400 hover:bg-[#161920]/60 hover:text-slate-200\'\\n                }`}\\n              >\\n                <Icon className=\\\"w-4 h-4 shrink-0\\\" />\\n                <span>{item.label}</span>\\n              </button>\\n            );\\n          })}\\n        </nav>\\n\\n        {/* Series Color Key & Auth Profile */}\\n        <div className=\\\"p-4 m-3 rounded-xl bg-[#161920] border border-slate-800/90 space-y-3\\\">\\n          <div className=\\\"text-xs font-medium text-slate-400\\\">\\n            NASCAR Series Feeds\\n          </div>\\n          <div className=\\\"space-y-1.5 text-xs\\\">\\n            <div className=\\\"flex items-center justify-between text-slate-300\\\">\\n              <span>Cup Series</span>\\n              <span className=\\\"font-mono text-[#F59E0B]\\\">Series 1</span>\\n            </div>\\n            <div className=\\\"flex items-center justify-between text-slate-300\\\">\\n              <span>O&apos;Reilly&apos;s Series</span>\\n              <span className=\\\"font-mono text-[#EF4444]\\\">Series 2</span>\\n            </div>\\n            <div className=\\\"flex items-center justify-between text-slate-300\\\">\\n              <span>Truck Series</span>\\n              <span className=\\\"font-mono text-[#3B82F6]\\\">Series 3</span>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"pt-3 border-t border-slate-800\\\">\\n            {firebaseUser ? (\\n              <div className=\\\"flex items-center justify-between gap-2\\\">\\n                <div className=\\\"truncate text-xs\\\">\\n                  <div className=\\\"font-semibold text-white truncate\\\">\\n                    {firebaseUser.displayName || firebaseUser.email}\\n                  </div>\\n                  <div className=\\\"text-slate-400\\\">Commissioner Linked</div>\\n                </div>\\n                <button\\n                  onClick={handleSignOut}\\n                  title=\\\"Sign out\\\"\\n                  className=\\\"min-h-[40px] min-w-[40px] flex items-center justify-center rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 cursor-pointer shrink-0\\\"\\n                >\\n                  <LogOut className=\\\"w-4 h-4\\\" />\\n                </button>\\n              </div>\\n            ) : (\\n              <button\\n                onClick={handleGoogleSignIn}\\n                className=\\\"w-full min-h-[40px] px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-200 flex items-center justify-center gap-2 transition-colors cursor-pointer whitespace-nowrap shrink-0\\\"\\n              >\\n                <LogIn className=\\\"w-3.5 h-3.5 text-amber-400\\\" />\\n                <span>Sign In with Google</span>\\n              </button>\\n            )}\\n          </div>\\n        </div>\\n      </aside>\\n\\n      {/* MAIN CONTENT VIEWPORT */}\\n      <div className=\\\"flex-1 md:pl-64 flex flex-col min-h-screen pb-20 md:pb-10\\\">\\n        {/* 3-ZONE TOP BAR CONTRACT */}\\n        <header className=\\\"sticky top-0 z-20 bg-[#0B0D10]/90 backdrop-blur-md border-b border-slate-800/80 px-4 py-2.5 md:px-8\\\">\\n          <div className=\\\"max-w-7xl mx-auto flex items-center justify-between gap-8\\\">\\n            {/* Zone 1: Single text element wordmark */}\\n            <a\\n              href=\\\"#top\\\"\\n              onClick={(e) => {\\n                e.preventDefault();\\n                setActiveTab(\'picks\');\\n              }}\\n              className=\\\"font-display text-xl font-bold tracking-wide text-white whitespace-nowrap shrink-0\\\"\\n            >\\n              Bristol Night Weekend \302\267 W36\\n            </a>\\n\\n            {/* Zone 2: Concise single-line navigation links */}\\n            <nav className=\\\"hidden lg:flex items-center gap-6 text-sm font-medium text-slate-400\\\">\\n              {[\\n                { id: \'picks\', label: \'Weekly Picks\' },\\n                { id: \'standings\', label: \'Standings\' },\\n                { id: \'bank\', label: \'Driver Bank\' },\\n                { id: \'draft\', label: \'Season Roster\' },\\n                { id: \'admin\', label: \'Admin\' },\\n              ].map((nav) => (\\n                <button\\n                  key={nav.id}\\n                  onClick={() => setActiveTab(nav.id as any)}\\n                  className={`hover:text-white transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\\n                    activeTab === nav.id\\n                      ? \'text-white underline underline-offset-8 decoration-amber-500 decoration-2\'\\n                      : \'\'\\n                  }`}\\n                >\\n                  {nav.label}\\n                </button>\\n              ))}\\n            </nav>\\n\\n            {/* Zone 3: 1 Primary Action (Sync Now) */}\\n            <div className=\\\"flex items-center gap-3 shrink-0\\\">\\n              <button\\n                onClick={handleManualSync}\\n                disabled={isSyncing}\\n                className=\\\"min-h-[40px] px-4 py-2 rounded-lg text-xs font-semibold bg-amber-500 hover:bg-amber-400 text-black transition-colors flex items-center gap-2 cursor-pointer disabled:opacity-50 whitespace-nowrap shrink-0\\\"\\n              >\\n                <RefreshCw\\n                  className={`w-3.5 h-3.5 ${isSyncing ? \'animate-spin\' : \'\'}`}\\n                />\\n                <span>{isSyncing ? \'Syncing CDN...\' : \'Sync Now\'}</span>\\n              </button>\\n            </div>\\n          </div>\\n        </header>\\n\\n        {/* WORKSPACE TELEMETRY & BUSCHWHACKER TOOLBAR */}\\n        <div className=\\\"bg-[#12151B] border-b border-slate-800/80 px-4 py-3 md:px-8\\\">\\n          <div className=\\\"max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-3 text-xs\\\">\\n            <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n              <span className=\\\"text-slate-400 font-medium\\\">\\n                Buschwhacker &amp; Car Anchor Simulation:\\n              </span>\\n\\n              <button\\n                onClick={() =>\\n                  handleUpdateAdminSetting({\\n                    simulateZilischInjury: !simulateZilischInjury,\\n                  })\\n                }\\n                className={`min-h-[36px] px-3 py-1.5 rounded-lg font-medium border transition-colors cursor-pointer whitespace-nowrap shrink-0 ${\\n                  simulateZilischInjury\\n                    ? \'bg-amber-500/15 text-amber-300 border-amber-500/40\'\\n                    : \'bg-[#161920] text-slate-300 border-slate-800\'\\n                }`}\\n              >\\n                #88 Zilisch DNS (Sub: Kyle Larson):{\' \'}\\n                {simulateZilischInjury ? \'Active\' : \'Off\'}\\n              </button>\\n\\n              <button\\n                onClick={() =>\\n                  handleUpdateAdminSetting({\\n                    useCarAnchorFallback: !useCarAnchorFallback,\\n                  })\\n                }\\n                className={`min-h-[36px] px-3 py-1.5 rounded-lg font-medium border transition-colors cursor-pointer whitespace-nowrap shrink-0 ${\\n                  useCarAnchorFallback\\n                    ? \'bg-emerald-500/15 text-emerald-300 border-emerald-500/40\'\\n                    : \'bg-[#161920] text-slate-300 border-slate-800\'\\n                }`}\\n              >\\n                Car Anchor Injury Protection:{\' \'}\\n                {useCarAnchorFallback ? \'Enabled\' : \'Disabled\'}\\n              </button>\\n            </div>\\n\\n            <div className=\\\"flex items-center gap-3 text-slate-400\\\">\\n              <span>\\n                1st Place Scale:{\' \'}\\n                <button\\n                  onClick={() =>\\n                    handleUpdateAdminSetting({\\n                      firstPlacePoints: firstPlacePoints === 55 ? 40 : 55,\\n                    })\\n                  }\\n                  className=\\\"font-mono font-semibold text-amber-400 hover:underline cursor-pointer\\\"\\n                >\\n                  {firstPlacePoints} Pts\\n                </button>\\n              </span>\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span className=\\\"font-mono\\\">Synced {lastSyncedAt}</span>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* STATUS NOTIFICATION BANNER */}\\n        {statusBanner && (\\n          <div className=\\\"max-w-7xl w-full mx-auto px-4 pt-4 md:px-8\\\">\\n            <div\\n              className={`px-4 py-3 rounded-xl border text-xs flex items-center justify-between gap-3 ${\\n                statusBanner.type === \'error\'\\n                  ? \'bg-red-500/10 border-red-500/30 text-red-300\'\\n                  : statusBanner.type === \'success\'\\n                  ? \'bg-emerald-500/10 border-emerald-500/30 text-emerald-300\'\\n                  : \'bg-[#161920] border-slate-700 text-slate-200\'\\n              }`}\\n            >\\n              <div className=\\\"flex items-center gap-2\\\">\\n                {statusBanner.type === \'error\' ? (\\n                  <AlertCircle className=\\\"w-4 h-4 shrink-0\\\" />\\n                ) : (\\n                  <Check className=\\\"w-4 h-4 shrink-0\\\" />\\n                )}\\n                <span>{statusBanner.text}</span>\\n              </div>\\n              <button\\n                onClick={() => setStatusBanner(null)}\\n                className=\\\"text-slate-400 hover:text-white cursor-pointer whitespace-nowrap shrink-0\\\"\\n              >\\n                Dismiss\\n              </button>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* MAIN VIEW SWITCHER */}\\n        <main className=\\\"flex-1 max-w-7xl w-full mx-auto p-4 md:p-8 space-y-8\\\">\\n          {/* ==========================================\\n              TAB 1: WEEKLY PICKS & BLIND LOCKOUT BOARD\\n          ========================================== */}\\n          {activeTab === \'picks\' && (\\n            <div className=\\\"space-y-8\\\">\\n              <div className=\\\"flex flex-col lg:flex-row lg:items-end justify-between gap-4\\\">\\n                <div>\\n                  <h1 className=\\\"font-display text-3xl md:text-4xl font-bold tracking-wide text-white\\\">\\n                    Weekly Picks &amp; Blind Lockout Board\\n                  </h1>\\n                  <p className=\\\"text-sm text-slate-400 mt-1 max-w-2xl\\\">\\n                    Select one driver per active series racing this weekend. Rival picks stay hidden until Green Flag (`current_time &gt;= race_start_time`), and Buschwhackers automatically award full Vehicle Owner Points.\\n                  </p>\\n                </div>\\n\\n                {/* Green Flag Lock/Reveal Simulator Controls */}\\n                <div className=\\\"flex flex-wrap items-center gap-2 bg-[#161920] p-1.5 rounded-xl border border-slate-800\\\">\\n                  <span className=\\\"text-xs text-slate-400 px-2\\\">\\n                    Green Flag State:\\n                  </span>\\n                  {([3, 2, 1] as SeriesId[]).map((sId) => {\\n                    const raceObj = weekendRacesBySeries[sId];\\n                    const locked = Boolean(raceObj?.isLockedRevealed);\\n                    return (\\n                      <button\\n                        key={sId}\\n                        onClick={() =>\\n                          handleUpdateAdminSetting({\\n                            raceLocks: { [sId]: !locked },\\n                          })\\n                        }\\n                        className={`min-h-[38px] flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors cursor-pointer whitespace-nowrap shrink-0 ${\\n                          locked\\n                            ? \'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30\'\\n                            : \'bg-[#0B0D10] text-slate-300 border border-slate-800\'\\n                        }`}\\n                      >\\n                        {locked ? (\\n                          <Unlock className=\\\"w-3.5 h-3.5\\\" />\\n                        ) : (\\n                          <Lock className=\\\"w-3.5 h-3.5\\\" />\\n                        )}\\n                        <span>\\n                          {SERIES_META[sId].shortName}:{\' \'}\\n                          {locked ? \'Revealed\' : \'Blind Lock\'}\\n                        </span>\\n                      </button>\\n                    );\\n                  })}\\n                </div>\\n              </div>\\n\\n              {/* 3 SERIES PICK CARDS */}\\n              <div className=\\\"grid grid-cols-1 lg:grid-cols-3 gap-6\\\">\\n                {([1, 2, 3] as SeriesId[]).map((sId) => {\\n                  const meta = SERIES_META[sId];\\n                  const raceObj = weekendRacesBySeries[sId];\\n                  const isActiveWeekend = raceObj?.isActiveWeekend ?? true;\\n                  const isRaceStarted = Boolean(raceObj?.isLockedRevealed);\\n\\n                  const myPickScoreObj =\\n                    sId === 1\\n                      ? activeUserRow?.breakdown.cupWeekly\\n                      : sId === 2\\n                      ? activeUserRow?.breakdown.oreillysWeekly\\n                      : activeUserRow?.breakdown.trucksWeekly;\\n\\n                  const currentPickedId = myPickScoreObj?.driverId || \'\';\\n                  const seriesDrivers = (leagueState?.drivers || []).filter(\\n                    (d) => d.seriesId === sId\\n                  );\\n\\n                  if (!isActiveWeekend) {\\n                    return (\\n                      <div\\n                        key={sId}\\n                        className=\\\"bg-[#161920] border border-slate-800/90 rounded-2xl p-6 flex flex-col justify-between\\\"\\n                      >\\n                        <div className=\\\"flex items-center justify-between text-xs text-slate-400\\\">\\n                          <span className={`font-semibold ${meta.textClass}`}>\\n                            {meta.name}\\n                          </span>\\n                          <span>Off-Week</span>\\n                        </div>\\n                        <div className=\\\"my-8 space-y-2\\\">\\n                          <h3 className=\\\"text-lg font-semibold text-slate-200\\\">\\n                            No {meta.shortName} Race Scheduled\\n                          </h3>\\n                          <p className=\\\"text-xs text-slate-400 leading-relaxed\\\">\\n                            Auto-detected via cf.nascar.com schedule feed. Weekly pick slot is hidden for this weekend.\\n                          </p>\\n                        </div>\\n                        <button\\n                          onClick={() =>\\n                            handleUpdateAdminSetting({\\n                              activeSeriesWeekend: { [sId]: true },\\n                            })\\n                          }\\n                          className=\\\"min-h-[44px] w-full py-2 px-4 rounded-xl text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 cursor-pointer whitespace-nowrap shrink-0\\\"\\n                        >\\n                          Restore Series Pick Slot\\n                        </button>\\n                      </div>\\n                    );\\n                  }\\n\\n                  return (\\n                    <div\\n                      key={sId}\\n                      className={`bg-[#161920] border ${meta.borderSubtle} rounded-2xl p-6 flex flex-col justify-between space-y-5`}\\n                    >\\n                      <div className=\\\"space-y-4\\\">\\n                        <div className=\\\"flex items-center justify-between text-xs\\\">\\n                          <span className={`font-semibold ${meta.textClass}`}>\\n                            {meta.name}\\n                          </span>\\n                          <span className=\\\"text-slate-400 font-mono\\\">\\n                            {isRaceStarted\\n                              ? \'Green Flag \302\267 Picks Revealed\'\\n                              : \'Pre-Race \302\267 Blind Lock\'}\\n                          </span>\\n                        </div>\\n\\n                        <div>\\n                          <h3 className=\\\"text-lg font-bold text-white\\\">\\n                            {raceObj?.raceName}\\n                          </h3>\\n                          <p className=\\\"text-xs text-slate-400 mt-1\\\">\\n                            {raceObj?.trackName} \302\267 Matched by NASCAR Driver ID\\n                          </p>\\n                        </div>\\n\\n                        <div className=\\\"space-y-2\\\">\\n                          <label className=\\\"text-xs font-medium text-slate-300 block\\\">\\n                            Select Weekly Driver (Max {meta.maxWeeklyUses} Uses)\\n                          </label>\\n                          <select\\n                            disabled={isRaceStarted}\\n                            value={currentPickedId}\\n                            onChange={(e) =>\\n                              handleSelectWeeklyPick(sId, e.target.value)\\n                            }\\n                            className=\\\"w-full min-h-[44px] bg-[#0B0D10] border border-slate-700 rounded-xl px-3.5 py-2.5 text-sm font-medium text-white focus:outline-none focus:border-amber-500 disabled:opacity-60\\\"\\n                          >\\n                            {seriesDrivers.map((d) => {\\n                              const usage = getDriverRemainingUses(d.id, sId);\\n                              const isOut =\\n                                usage.remaining === 0 &&\\n                                currentPickedId !== d.id;\\n                              return (\\n                                <option key={d.id} value={d.id} disabled={isOut}>\\n                                  #{d.carNumber} {d.fullName} \342\200\224 {usage.remaining}/\\n                                  {usage.maxUses} Uses Left{\' \'}\\n                                  {isOut ? \'(0 Uses Left)\' : \'\'}\\n                                </option>\\n                              );\\n                            })}\\n                          </select>\\n                        </div>\\n\\n                        {/* Dynamic Ride-Swap & Buschwhacker Resolution Summary */}\\n                        <div className=\\\"pt-3 border-t border-slate-800/80 space-y-1.5\\\">\\n                          <div className=\\\"flex items-center justify-between text-xs text-slate-400\\\">\\n                            <span>Scoring Resolution</span>\\n                            <span className=\\\"font-mono text-slate-300\\\">\\n                              {myPickScoreObj?.isOwnerPts\\n                                ? \'Vehicle / Owner Points\'\\n                                : \'Official Driver Points\'}\\n                            </span>\\n                          </div>\\n                          <div className=\\\"text-sm font-semibold text-white font-mono\\\">\\n                            {myPickScoreObj?.label}\\n                          </div>\\n                        </div>\\n                      </div>\\n\\n                      <div className=\\\"pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400\\\">\\n                        <span>\\n                          {isRaceStarted\\n                            ? \'Locked after Green Flag\'\\n                            : \'Editable until Green Flag\'}\\n                        </span>\\n                        <button\\n                          onClick={() =>\\n                            handleUpdateAdminSetting({\\n                              activeSeriesWeekend: { [sId]: false },\\n                            })\\n                          }\\n                          className=\\\"text-slate-400 hover:text-white underline cursor-pointer whitespace-nowrap shrink-0\\\"\\n                        >\\n                          Simulate Off-Week\\n                        </button>\\n                      </div>\\n                    </div>\\n                  );\\n                })}\\n              </div>\\n\\n              {/* LEAGUE-WIDE BLIND LOCKOUT TABLE */}\\n              <div className=\\\"bg-[#161920] border border-slate-800/90 rounded-2xl overflow-hidden\\\">\\n                <div className=\\\"p-6 border-b border-slate-800/90\\\">\\n                  <h2 className=\\\"font-display text-2xl font-bold tracking-wide text-white\\\">\\n                    League-Wide Weekly Pick Board\\n                  </h2>\\n                  <p className=\\\"text-xs text-slate-400 mt-1\\\">\\n                    Rival picks display only lock status until Green Flag (`current_time &gt;= race_start_time`), then reveal the driver and dynamically matched vehicle number.\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"overflow-x-auto\\\">\\n                  <table className=\\\"w-full text-left border-collapse\\\">\\n                    <thead>\\n                      <tr className=\\\"border-b border-slate-800 bg-[#12151B] text-xs font-medium text-slate-400\\\">\\n                        <th className=\\\"py-3.5 px-5\\\">League Manager</th>\\n                        <th className=\\\"py-3.5 px-5 text-[#F59E0B]\\\">\\n                          Cup Series ({weekendRacesBySeries[1]?.isLockedRevealed ? \'Revealed\' : \'Blind Lock\'})\\n                        </th>\\n                        <th className=\\\"py-3.5 px-5 text-[#EF4444]\\\">\\n                          O&apos;Reilly&apos;s Series ({weekendRacesBySeries[2]?.isLockedRevealed ? \'Revealed\' : \'Blind Lock\'})\\n                        </th>\\n                        <th className=\\\"py-3.5 px-5 text-[#3B82F6]\\\">\\n                          Truck Series ({weekendRacesBySeries[3]?.isLockedRevealed ? \'Revealed\' : \'Blind Lock\'})\\n                        </th>\\n                      </tr>\\n                    </thead>\\n                    <tbody className=\\\"divide-y divide-slate-800/70 text-sm\\\">\\n                      {leaderboard.map((member) => {\\n                        const isMe = member.id === activeManagerId;\\n                        return (\\n                          <tr\\n                            key={member.id}\\n                            className=\\\"hover:bg-slate-800/25 transition-colors\\\"\\n                          >\\n                            <td className=\\\"py-4 px-5 whitespace-nowrap\\\">\\n                              <div className=\\\"font-semibold text-white\\\">\\n                                {member.name}\\n                              </div>\\n                              <div className=\\\"text-xs text-slate-400\\\">\\n                                Last Year Rank #{member.lastYearRank}\\n                              </div>\\n                            </td>\\n\\n                            {([1, 2, 3] as SeriesId[]).map((sId) => {\\n                              const raceObj = weekendRacesBySeries[sId];\\n                              const isRevealed = Boolean(\\n                                raceObj?.isLockedRevealed\\n                              );\\n                              const scoreObj =\\n                                sId === 1\\n                                  ? member.breakdown.cupWeekly\\n                                  : sId === 2\\n                                  ? member.breakdown.oreillysWeekly\\n                                  : member.breakdown.trucksWeekly;\\n\\n                              if (!raceObj?.isActiveWeekend) {\\n                                return (\\n                                  <td\\n                                    key={sId}\\n                                    className=\\\"py-4 px-5 text-xs text-slate-500\\\"\\n                                  >\\n                                    Series Off-Week\\n                                  </td>\\n                                );\\n                              }\\n\\n                              if (!isRevealed && !isMe) {\\n                                return (\\n                                  <td key={sId} className=\\\"py-4 px-5\\\">\\n                                    <div className=\\\"inline-flex items-center gap-1.5 text-xs font-mono text-amber-400\\\">\\n                                      <Lock className=\\\"w-3.5 h-3.5 shrink-0\\\" />\\n                                      <span>Pick Locked In</span>\\n                                    </div>\\n                                  </td>\\n                                );\\n                              }\\n\\n                              return (\\n                                <td key={sId} className=\\\"py-4 px-5\\\">\\n                                  <div className=\\\"font-medium text-slate-100 font-mono text-xs md:text-sm\\\">\\n                                    {scoreObj.label}\\n                                  </div>\\n                                  <div className=\\\"text-xs text-slate-400 mt-0.5\\\">\\n                                    {!isRevealed && isMe\\n                                      ? \'Your Pick \302\267 Hidden from Rivals\'\\n                                      : scoreObj.isOwnerPts\\n                                      ? \'Buschwhacker / Ride-Swap Vehicle Owner Pts\'\\n                                      : \'Official NASCAR Driver Points\'}\\n                                  </div>\\n                                </td>\\n                              );\\n                            })}\\n                          </tr>\\n                        );\\n                      })}\\n                    </tbody>\\n                  </table>\\n                </div>\\n              </div>\\n            </div>\\n          )}\\n\\n          {/* ==========================================\\n              TAB 2: LIVE STANDINGS & MATRIX BREAKDOWN\\n          ========================================== */}\\n          {activeTab === \'standings\' && (\\n            <div className=\\\"space-y-8\\\">\\n              <div className=\\\"flex flex-col sm:flex-row sm:items-end justify-between gap-4\\\">\\n                <div>\\n                  <h1 className=\\\"font-display text-3xl md:text-4xl font-bold tracking-wide text-white\\\">\\n                    Live Standings &amp; Weekend Matrix Breakdown\\n                  </h1>\\n                  <p className=\\\"text-sm text-slate-400 mt-1\\\">\\n                    Automatically combines Weekly Picks, Exclusive Season Rosters, Mid-Season Cup Chase Bonus Picks, and Car Anchor Injury Fallbacks.\\n                  </p>\\n                </div>\\n\\n                {/* Segmented Interactive Filter Control */}\\n                <div className=\\\"flex items-center gap-1 p-1 bg-[#161920] rounded-xl border border-slate-800\\\">\\n                  {[\\n                    { id: \'all\', label: \'Combined Total\' },\\n                    { id: \'weekly_only\', label: \'Weekly Picks\' },\\n                    { id: \'season_only\', label: \'Season Roster\' },\\n                  ].map((f) => (\\n                    <button\\n                      key={f.id}\\n                      onClick={() => setStandingsViewFilter(f.id as any)}\\n                      className={`min-h-[38px] px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap shrink-0 ${\\n                        standingsViewFilter === f.id\\n                          ? \'bg-amber-500 text-black\'\\n                          : \'text-slate-400 hover:text-white\'\\n                      }`}\\n                    >\\n                      {f.label}\\n                    </button>\\n                  ))}\\n                </div>\\n              </div>\\n\\n              {/* Scoring Formula Reference Bar */}\\n              <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-5\\\">\\n                <div className=\\\"bg-[#161920] border border-slate-800/90 rounded-2xl p-5\\\">\\n                  <div className=\\\"text-xs font-semibold text-[#F59E0B]\\\">\\n                    Cup Series Race Score\\n                  </div>\\n                  <p className=\\\"text-xs text-slate-300 mt-1.5 leading-relaxed\\\">\\n                    Weekly Pick + Season Chase Driver + Season Non-Chase Driver{\' \'}\\n                    {midSeasonChaseActive ? \'+ 5th Slot Cup Chase Bonus\' : \'\'}\\n                  </p>\\n                </div>\\n                <div className=\\\"bg-[#161920] border border-slate-800/90 rounded-2xl p-5\\\">\\n                  <div className=\\\"text-xs font-semibold text-[#EF4444]\\\">\\n                    O&apos;Reilly&apos;s Series Race Score\\n                  </div>\\n                  <p className=\\\"text-xs text-slate-300 mt-1.5 leading-relaxed\\\">\\n                    Weekly Pick (Buschwhacker Owner Pts Active) + Season Driver (With #88 Car Anchor)\\n                  </p>\\n                </div>\\n                <div className=\\\"bg-[#161920] border border-slate-800/90 rounded-2xl p-5\\\">\\n                  <div className=\\\"text-xs font-semibold text-[#3B82F6]\\\">\\n                    Truck Series Race Score\\n                  </div>\\n                  <p className=\\\"text-xs text-slate-300 mt-1.5 leading-relaxed\\\">\\n                    Weekly Pick (Buschwhacker Owner Pts Active) + Season Driver\\n                  </p>\\n                </div>\\n              </div>\\n\\n              {/* Full Matrix Breakdown Table */}\\n              <div className=\\\"bg-[#161920] border border-slate-800/90 rounded-2xl overflow-hidden\\\">\\n                <div className=\\\"overflow-x-auto\\\">\\n                  <table className=\\\"w-full text-left border-collapse\\\">\\n                    <thead>\\n                      <tr className=\\\"border-b border-slate-800 bg-[#12151B] text-xs font-medium text-slate-400\\\">\\n                        <th className=\\\"py-3.5 px-5\\\">Rank \302\267 Manager</th>\\n                        <th className=\\\"py-3.5 px-5 text-[#F59E0B]\\\">\\n                          Cup Series Matrix\\n                        </th>\\n                        <th className=\\\"py-3.5 px-5 text-[#EF4444]\\\">\\n                          O&apos;Reilly&apos;s Matrix\\n                        </th>\\n                        <th className=\\\"py-3.5 px-5 text-[#3B82F6]\\\">\\n                          Trucks Matrix\\n                        </th>\\n                        <th className=\\\"py-3.5 px-5 text-right\\\">Weekend</th>\\n                        <th className=\\\"py-3.5 px-5 text-right text-emerald-400\\\">\\n                          Season Total\\n                        </th>\\n                      </tr>\\n                    </thead>\\n                    <tbody className=\\\"divide-y divide-slate-800/80 text-xs\\\">\\n                      {leaderboard.map((member, idx) => {\\n                        const b = member.breakdown;\\n                        return (\\n                          <tr\\n                            key={member.id}\\n                            className=\\\"hover:bg-slate-800/25 transition-colors align-top\\\"\\n                          >\\n                            <td className=\\\"py-4 px-5 whitespace-nowrap\\\">\\n                              <div className=\\\"font-mono font-bold text-sm text-white\\\">\\n                                {String(idx + 1).padStart(2, \'0\')} \302\267 {member.name}\\n                              </div>\\n                              <div className=\\\"text-slate-400 font-mono mt-1\\\">\\n                                Prior Season Pts: {member.cumulativePriorPoints}\\n                              </div>\\n                            </td>\\n\\n                            <td className=\\\"py-4 px-5 space-y-1.5 min-w-[250px] font-mono\\\">\\n                              <div className=\\\"text-slate-200\\\">\\n                                Wk: {b.cupWeekly.label}\\n                              </div>\\n                              <div className=\\\"text-slate-400\\\">\\n                                Chase: {b.cupSeasonChase.badgeText}\\n                              </div>\\n                              <div className=\\\"text-slate-400\\\">\\n                                Non-Chase: {b.cupSeasonNonChase.badgeText}\\n                              </div>\\n                              {midSeasonChaseActive && (\\n                                <div className=\\\"text-amber-300\\\">\\n                                  5th Slot: {b.cupMidSeasonBonus.badgeText}\\n                                </div>\\n                              )}\\n                              <div className=\\\"pt-1 font-bold text-[#F59E0B]\\\">\\n                                Subtotal: {b.cupTotal} pts\\n                              </div>\\n                            </td>\\n\\n                            <td className=\\\"py-4 px-5 space-y-1.5 min-w-[240px] font-mono\\\">\\n                              <div className=\\\"text-slate-200\\\">\\n                                Wk: {b.oreillysWeekly.label}\\n                              </div>\\n                              <div\\n                                className={\\n                                  b.oreillysSeason.usedCarAnchor\\n                                    ? \'text-emerald-300 font-semibold\'\\n                                    : \'text-slate-400\'\\n                                }\\n                              >\\n                                Season: {b.oreillysSeason.badgeText}\\n                              </div>\\n                              <div className=\\\"pt-1 font-bold text-[#EF4444]\\\">\\n                                Subtotal: {b.oreillysTotal} pts\\n                              </div>\\n                            </td>\\n\\n                            <td className=\\\"py-4 px-5 space-y-1.5 min-w-[220px] font-mono\\\">\\n                              <div className=\\\"text-slate-200\\\">\\n                                Wk: {b.trucksWeekly.label}\\n                              </div>\\n                              <div className=\\\"text-slate-400\\\">\\n                                Season: {b.trucksSeason.badgeText}\\n                              </div>\\n                              <div className=\\\"pt-1 font-bold text-[#3B82F6]\\\">\\n                                Subtotal: {b.trucksTotal} pts\\n                              </div>\\n                            </td>\\n\\n                            <td className=\\\"py-4 px-5 text-right font-mono whitespace-nowrap\\\">\\n                              <div className=\\\"text-base font-bold text-white\\\">\\n                                +{b.weekendTotal}\\n                              </div>\\n                              <div className=\\\"text-slate-400 mt-0.5\\\">\\n                                Wk {b.weeklyOnlyWeekendTotal} \302\267 Ros{\' \'}\\n                                {b.seasonOnlyWeekendTotal}\\n                              </div>\\n                            </td>\\n\\n                            <td className=\\\"py-4 px-5 text-right font-mono whitespace-nowrap\\\">\\n                              <div className=\\\"text-lg font-bold text-emerald-400\\\">\\n                                {b.grandTotal.toLocaleString()}\\n                              </div>\\n                              <div className=\\\"text-slate-400 mt-0.5\\\">Points</div>\\n                            </td>\\n                          </tr>\\n                        );\\n                      })}\\n                    </tbody>\\n                  </table>\\n                </div>\\n              </div>\\n            </div>\\n          )}\\n\\n          {/* ==========================================\\n              TAB 3: DRIVER USAGE BANK\\n          ========================================== */}\\n          {activeTab === \'bank\' && (\\n            <div className=\\\"space-y-8\\\">\\n              <div className=\\\"flex flex-col sm:flex-row sm:items-end justify-between gap-4\\\">\\n                <div>\\n                  <h1 className=\\\"font-display text-3xl md:text-4xl font-bold tracking-wide text-white\\\">\\n                    Driver Usage Bank\\n                  </h1>\\n                  <p className=\\\"text-sm text-slate-400 mt-1\\\">\\n                    Filter by Cup, O&apos;Reilly&apos;s, or Trucks to inspect remaining weekly uses and track history. Drivers at 0 uses left are automatically disabled.\\n                  </p>\\n                </div>\\n\\n                {/* Series Segmented Control */}\\n                <div className=\\\"flex items-center gap-1 p-1 bg-[#161920] rounded-xl border border-slate-800\\\">\\n                  {([1, 2, 3] as SeriesId[]).map((sId) => (\\n                    <button\\n                      key={sId}\\n                      onClick={() => setBankSeriesFilter(sId)}\\n                      className={`min-h-[38px] px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap shrink-0 ${\\n                        bankSeriesFilter === sId\\n                          ? \'bg-slate-800 text-white\'\\n                          : \'text-slate-400 hover:text-white\'\\n                      }`}\\n                    >\\n                      {SERIES_META[sId].shortName}\\n                    </button>\\n                  ))}\\n                </div>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\\\">\\n                {(leagueState?.drivers || [])\\n                  .filter((d) => d.seriesId === bankSeriesFilter)\\n                  .map((driver) => {\\n                    const usage = getDriverRemainingUses(\\n                      driver.id,\\n                      driver.seriesId as SeriesId\\n                    );\\n                    const isDepleted = usage.remaining === 0;\\n\\n                    return (\\n                      <div\\n                        key={driver.id}\\n                        className={`bg-[#161920] border rounded-2xl p-6 flex flex-col justify-between space-y-4 ${\\n                          isDepleted\\n                            ? \'border-red-500/40 opacity-70\'\\n                            : usage.isCurrentlyPicked\\n                            ? \'border-amber-500/60\'\\n                            : \'border-slate-800/90\'\\n                        }`}\\n                      >\\n                        <div className=\\\"space-y-4\\\">\\n                          <div className=\\\"flex items-start justify-between gap-3\\\">\\n                            <div>\\n                              <div className=\\\"font-mono text-sm font-bold text-amber-400\\\">\\n                                #{driver.carNumber} \302\267 {driver.team}\\n                              </div>\\n                              <h3 className=\\\"text-lg font-bold text-white mt-0.5\\\">\\n                                {driver.fullName}\\n                              </h3>\\n                            </div>\\n                            <div\\n                              className={`font-mono text-xs font-bold ${\\n                                isDepleted\\n                                  ? \'text-red-400\'\\n                                  : \'text-emerald-400\'\\n                              }`}\\n                            >\\n                              {usage.remaining}/{usage.maxUses} Uses Left\\n                            </div>\\n                          </div>\\n\\n                          {/* Usage Progress Bar */}\\n                          <div className=\\\"w-full bg-[#0B0D10] h-2 rounded-full overflow-hidden border border-slate-800\\\">\\n                            <div\\n                              className={`h-full ${\\n                                isDepleted ? \'bg-red-500\' : \'bg-amber-500\'\\n                              }`}\\n                              style={{\\n                                width: `${Math.min(\\n                                  100,\\n                                  (usage.used / usage.maxUses) * 100\\n                                )}%`,\\n                              }}\\n                            />\\n                          </div>\\n\\n                          {/* Unboxed Track History Metadata */}\\n                          <div className=\\\"space-y-1 text-xs\\\">\\n                            <div className=\\\"text-slate-400\\\">\\n                              Tracks Used ({usage.used}):\\n                            </div>\\n                            <div className=\\\"text-slate-200 font-mono leading-relaxed\\\">\\n                              {usage.pastTracks.length > 0\\n                                ? usage.pastTracks.join(\' \302\267 \')\\n                                : \'Unused prior to this weekend\'}\\n                              {usage.isCurrentlyPicked\\n                                ? \' \302\267 Bristol Night (Active Pick)\'\\n                                : \'\'}\\n                            </div>\\n                          </div>\\n                        </div>\\n\\n                        <div className=\\\"pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400 font-mono\\\">\\n                          <span>NASCAR ID: {driver.nascarDriverId}</span>\\n                          <span>\\n                            {driver.isBuschwhacker\\n                              ? \'Vehicle Owner Pts Eligible\'\\n                              : \'Series Championship Driver\'}\\n                          </span>\\n                        </div>\\n                      </div>\\n                    );\\n                  })}\\n              </div>\\n            </div>\\n          )}\\n\\n          {/* ==========================================\\n              TAB 4: PRE-SEASON EXCLUSIVE DRAFT & ROSTERS\\n          ========================================== */}\\n          {activeTab === \'draft\' && (\\n            <div className=\\\"space-y-8\\\">\\n              <div className=\\\"flex flex-col lg:flex-row lg:items-end justify-between gap-4\\\">\\n                <div>\\n                  <h1 className=\\\"font-display text-3xl md:text-4xl font-bold tracking-wide text-white\\\">\\n                    Exclusive Season Rosters &amp; Mid-Season Chase Pick\\n                  </h1>\\n                  <p className=\\\"text-sm text-slate-400 mt-1 max-w-2xl\\\">\\n                    4 permanent exclusive season-long drivers (zero duplicates allowed across the league) plus the 5th Mid-Season Cup Chase Bonus slot (duplicates allowed for the final 10 races).\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                  <button\\n                    onClick={() =>\\n                      setDraftOrderMode(\\n                        draftOrderMode === \'reverse_standings\'\\n                          ? \'random\'\\n                          : \'reverse_standings\'\\n                      )\\n                    }\\n                    className=\\\"min-h-[40px] flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-[#161920] border border-slate-700 text-slate-200 hover:border-amber-500 cursor-pointer whitespace-nowrap shrink-0\\\"\\n                  >\\n                    <ArrowUpDown className=\\\"w-3.5 h-3.5 text-amber-400\\\" />\\n                    <span>\\n                      Draft Order:{\' \'}\\n                      {draftOrderMode === \'reverse_standings\'\\n                        ? \\\"Reverse Last Year\'s Standings\\\"\\n                        : \'Randomized Order\'}\\n                    </span>\\n                  </button>\\n\\n                  <button\\n                    onClick={() =>\\n                      handleUpdateAdminSetting({\\n                        chaseActive: !midSeasonChaseActive,\\n                      })\\n                    }\\n                    className={`min-h-[40px] px-3.5 py-2 rounded-xl text-xs font-semibold border cursor-pointer whitespace-nowrap shrink-0 ${\\n                      midSeasonChaseActive\\n                        ? \'bg-amber-500/15 text-amber-300 border-amber-500/40\'\\n                        : \'bg-[#161920] text-slate-400 border-slate-800\'\\n                    }`}\\n                  >\\n                    5th Slot (Cup Chase Bonus):{\' \'}\\n                    {midSeasonChaseActive ? \'Unlocked\' : \'Locked\'}\\n                  </button>\\n                </div>\\n              </div>\\n\\n              {/* Draft Order Strip */}\\n              <div className=\\\"bg-[#161920] border border-slate-800/90 rounded-2xl p-6 space-y-4\\\">\\n                <div className=\\\"text-xs font-medium text-slate-400\\\">\\n                  Pre-Season Draft Order (\\n                  {draftOrderMode === \'reverse_standings\'\\n                    ? \\\"Reverse Order of Last Year\'s Standings\\\"\\n                    : \'Randomized Draw\'}\\n                  )\\n                </div>\\n                <div className=\\\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3\\\">\\n                  {sortedDraftOrder.map((m, i) => (\\n                    <div\\n                      key={m.id}\\n                      className=\\\"p-3.5 rounded-xl bg-[#0B0D10] border border-slate-800/90\\\"\\n                    >\\n                      <div className=\\\"font-mono text-xs text-amber-400 font-bold\\\">\\n                        Pick #{i + 1}\\n                      </div>\\n                      <div className=\\\"text-sm font-semibold text-white truncate mt-1\\\">\\n                        {m.name}\\n                      </div>\\n                      <div className=\\\"text-xs text-slate-400 font-mono mt-0.5\\\">\\n                        Prev Rank #{m.lastYearRank}\\n                      </div>\\n                    </div>\\n                  ))}\\n                </div>\\n              </div>\\n\\n              {/* Interactive Manager Roster & Car Anchor Editor */}\\n              <div className=\\\"bg-[#161920] border border-slate-800/90 rounded-2xl p-6 space-y-4\\\">\\n                <div>\\n                  <h2 className=\\\"font-display text-2xl font-bold tracking-wide text-white\\\">\\n                    Your Season Roster &amp; Car Anchor Protection\\n                  </h2>\\n                  <p className=\\\"text-xs text-slate-400 mt-1\\\">\\n                    Change your 5th Mid-Season Cup Chase Bonus Pick or update your Car Anchor fallback number at any time. Exclusive slots validate against league-wide ownership.\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"grid grid-cols-1 md:grid-cols-5 gap-4\\\">\\n                  {[\\n                    {\\n                      slotType: \'cup_prev_chase\',\\n                      label: \'1. Cup Chase Driver\',\\n                      seriesId: 1,\\n                      exclusive: true,\\n                    },\\n                    {\\n                      slotType: \'cup_prev_non_chase\',\\n                      label: \'2. Cup Non-Chase\',\\n                      seriesId: 1,\\n                      exclusive: true,\\n                    },\\n                    {\\n                      slotType: \'oreillys_season\',\\n                      label: \\\"3. O\'Reilly\'s Season\\\",\\n                      seriesId: 2,\\n                      exclusive: true,\\n                    },\\n                    {\\n                      slotType: \'trucks_season\',\\n                      label: \'4. Truck Season\',\\n                      seriesId: 3,\\n                      exclusive: true,\\n                    },\\n                    {\\n                      slotType: \'cup_current_chase\',\\n                      label: \'5. Cup Chase Bonus\',\\n                      seriesId: 1,\\n                      exclusive: false,\\n                    },\\n                  ].map((slotCfg) => {\\n                    const currentSlot = (\\n                      leagueState?.seasonRosters || []\\n                    ).find(\\n                      (r) =>\\n                        r.userId === activeManagerId &&\\n                        r.slotType === slotCfg.slotType\\n                    );\\n                    const eligibleDrivers = (\\n                      leagueState?.drivers || []\\n                    ).filter((d) => {\\n                      if (d.seriesId !== slotCfg.seriesId || d.isBuschwhacker)\\n                        return false;\\n                      if (slotCfg.slotType === \'cup_prev_chase\')\\n                        return d.madeLastYearChase;\\n                      if (slotCfg.slotType === \'cup_prev_non_chase\')\\n                        return !d.madeLastYearChase;\\n                      if (slotCfg.slotType === \'cup_current_chase\')\\n                        return d.inCurrentChase;\\n                      return true;\\n                    });\\n\\n                    return (\\n                      <div\\n                        key={slotCfg.slotType}\\n                        className=\\\"p-4 rounded-xl bg-[#0B0D10] border border-slate-800 space-y-3\\\"\\n                      >\\n                        <div className=\\\"text-xs font-semibold text-slate-300\\\">\\n                          {slotCfg.label}\\n                        </div>\\n                        <select\\n                          value={currentSlot?.driverId || \'\'}\\n                          onChange={(e) => {\\n                            const newDrv = (leagueState?.drivers || []).find(\\n                              (d) => d.id === e.target.value\\n                            );\\n                            if (newDrv) {\\n                              handleUpdateSeasonSlot(\\n                                slotCfg.seriesId,\\n                                slotCfg.slotType,\\n                                newDrv.id,\\n                                newDrv.carNumber\\n                              );\\n                            }\\n                          }}\\n                          className=\\\"w-full min-h-[40px] bg-[#161920] border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs font-medium text-white\\\"\\n                        >\\n                          {eligibleDrivers.map((d) => (\\n                            <option key={d.id} value={d.id}>\\n                              #{d.carNumber} {d.fullName}\\n                            </option>\\n                          ))}\\n                        </select>\\n                        <div className=\\\"text-xs text-slate-400 font-mono\\\">\\n                          Car Anchor: #{currentSlot?.fallbackCarNumber || \'-\'} \302\267{\' \'}\\n                          {slotCfg.exclusive ? \'Exclusive\' : \'Duplicates OK\'}\\n                        </div>\\n                      </div>\\n                    );\\n                  })}\\n                </div>\\n              </div>\\n\\n              {/* League-Wide Exclusive Season Roster Matrix */}\\n              <div className=\\\"bg-[#161920] border border-slate-800/90 rounded-2xl overflow-hidden\\\">\\n                <div className=\\\"overflow-x-auto\\\">\\n                  <table className=\\\"w-full text-left border-collapse\\\">\\n                    <thead>\\n                      <tr className=\\\"border-b border-slate-800 bg-[#12151B] text-xs font-medium text-slate-400\\\">\\n                        <th className=\\\"py-3.5 px-5\\\">Manager</th>\\n                        <th className=\\\"py-3.5 px-5 text-[#F59E0B]\\\">\\n                          1. Cup Chase (Exclusive)\\n                        </th>\\n                        <th className=\\\"py-3.5 px-5 text-[#F59E0B]\\\">\\n                          2. Cup Non-Chase (Exclusive)\\n                        </th>\\n                        <th className=\\\"py-3.5 px-5 text-[#EF4444]\\\">\\n                          3. O&apos;Reilly&apos;s (Exclusive)\\n                        </th>\\n                        <th className=\\\"py-3.5 px-5 text-[#3B82F6]\\\">\\n                          4. Trucks (Exclusive)\\n                        </th>\\n                        <th className=\\\"py-3.5 px-5 text-emerald-400\\\">\\n                          5. Mid-Season Chase (Duplicates OK)\\n                        </th>\\n                      </tr>\\n                    </thead>\\n                    <tbody className=\\\"divide-y divide-slate-800/70 text-xs\\\">\\n                      {(leagueState?.users || []).map((member) => {\\n                        const renderCell = (slotType: string) => {\\n                          const row = (leagueState?.seasonRosters || []).find(\\n                            (r) =>\\n                              r.userId === member.id && r.slotType === slotType\\n                          );\\n                          if (!row)\\n                            return <span className=\\\"text-slate-500\\\">-</span>;\\n                          const d = (leagueState?.drivers || []).find(\\n                            (drv) => drv.id === row.driverId\\n                          );\\n                          return (\\n                            <div>\\n                              <div className=\\\"font-semibold text-white\\\">\\n                                #{d?.carNumber} {d?.fullName}\\n                              </div>\\n                              <div className=\\\"text-slate-400 font-mono mt-0.5\\\">\\n                                Anchor #{row.fallbackCarNumber} \302\267 {d?.team}\\n                              </div>\\n                            </div>\\n                          );\\n                        };\\n\\n                        return (\\n                          <tr\\n                            key={member.id}\\n                            className=\\\"hover:bg-slate-800/25 transition-colors\\\"\\n                          >\\n                            <td className=\\\"py-4 px-5 font-semibold text-sm text-white whitespace-nowrap\\\">\\n                              {member.name}\\n                            </td>\\n                            <td className=\\\"py-4 px-5\\\">\\n                              {renderCell(\'cup_prev_chase\')}\\n                            </td>\\n                            <td className=\\\"py-4 px-5\\\">\\n                              {renderCell(\'cup_prev_non_chase\')}\\n                            </td>\\n                            <td className=\\\"py-4 px-5\\\">\\n                              {renderCell(\'oreillys_season\')}\\n                            </td>\\n                            <td className=\\\"py-4 px-5\\\">\\n                              {renderCell(\'trucks_season\')}\\n                            </td>\\n                            <td className=\\\"py-4 px-5\\\">\\n                              {midSeasonChaseActive ? (\\n                                renderCell(\'cup_current_chase\')\\n                              ) : (\\n                                <span className=\\\"text-slate-500 font-mono\\\">\\n                                  Locked until Race 27\\n                                </span>\\n                              )}\\n                            </td>\\n                          </tr>\\n                        );\\n                      })}\\n                    </tbody>\\n                  </table>\\n                </div>\\n              </div>\\n            </div>\\n          )}\\n\\n          {/* ==========================================\\n              TAB 5: SYNC STATUS & COMMISSIONER ADMIN\\n          ========================================== */}\\n          {activeTab === \'admin\' && (\\n            <div className=\\\"space-y-8\\\">\\n              <div>\\n                <h1 className=\\\"font-display text-3xl md:text-4xl font-bold tracking-wide text-white\\\">\\n                  NASCAR Data Pipeline &amp; Commissioner Rules\\n                </h1>\\n                <p className=\\\"text-sm text-slate-400 mt-1\\\">\\n                  Configure Buschwhacker Owner Points scales, Car Anchor injury fallback rules, and inspect live `cf.nascar.com` scoring ingestion.\\n                </p>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 lg:grid-cols-2 gap-6\\\">\\n                {/* Commissioner Scoring Rules */}\\n                <div className=\\\"bg-[#161920] border border-slate-800/90 rounded-2xl p-6 space-y-5\\\">\\n                  <h2 className=\\\"font-display text-2xl font-bold tracking-wide text-white\\\">\\n                    Commissioner League Rules\\n                  </h2>\\n\\n                  <div className=\\\"space-y-4\\\">\\n                    <div className=\\\"flex items-center justify-between gap-4 py-3 border-b border-slate-800\\\">\\n                      <div>\\n                        <div className=\\\"font-semibold text-sm text-white\\\">\\n                          Use Car Owner Points if Season Driver Misses Race\\n                        </div>\\n                        <div className=\\\"text-xs text-slate-400 mt-0.5\\\">\\n                          Automatically awards Owner Points of `fallback_car_number` (e.g. #88) when a drafted Season-Long driver misses a start.\\n                        </div>\\n                      </div>\\n                      <button\\n                        onClick={() =>\\n                          handleUpdateAdminSetting({\\n                            useCarAnchorFallback: !useCarAnchorFallback,\\n                          })\\n                        }\\n                        className={`min-h-[40px] px-4 py-2 rounded-lg text-xs font-semibold cursor-pointer whitespace-nowrap shrink-0 ${\\n                          useCarAnchorFallback\\n                            ? \'bg-emerald-500 text-black\'\\n                            : \'bg-slate-800 text-slate-300\'\\n                        }`}\\n                      >\\n                        {useCarAnchorFallback ? \'Enabled\' : \'Disabled\'}\\n                      </button>\\n                    </div>\\n\\n                    <div className=\\\"flex items-center justify-between gap-4 py-3 border-b border-slate-800\\\">\\n                      <div>\\n                        <div className=\\\"font-semibold text-sm text-white\\\">\\n                          1st Place Vehicle / Owner Points Scale\\n                        </div>\\n                        <div className=\\\"text-xs text-slate-400 mt-0.5\\\">\\n                          Controls 1st place points (55 pts vs 40 pts) when calculating Buschwhacker Owner Points.\\n                        </div>\\n                      </div>\\n                      <select\\n                        value={firstPlacePoints}\\n                        onChange={(e) =>\\n                          handleUpdateAdminSetting({\\n                            firstPlacePoints: Number(e.target.value) as 55 | 40,\\n                          })\\n                        }\\n                        className=\\\"min-h-[40px] bg-[#0B0D10] border border-slate-700 rounded-lg px-3 py-1.5 text-xs font-mono font-bold text-amber-400\\\"\\n                      >\\n                        <option value={55}>55 Points (1st)</option>\\n                        <option value={40}>40 Points (1st)</option>\\n                      </select>\\n                    </div>\\n\\n                    <div className=\\\"flex items-center justify-between gap-4 py-2\\\">\\n                      <div>\\n                        <div className=\\\"font-semibold text-sm text-white\\\">\\n                          Simulate #88 Connor Zilisch DNS (Kyle Larson Sub)\\n                        </div>\\n                        <div className=\\\"text-xs text-slate-400 mt-0.5\\\">\\n                          Tests both Ride-Swapping resolution and Season-Long #88 Car Anchor fallback in O&apos;Reilly&apos;s.\\n                        </div>\\n                      </div>\\n                      <button\\n                        onClick={() =>\\n                          handleUpdateAdminSetting({\\n                            simulateZilischInjury: !simulateZilischInjury,\\n                          })\\n                        }\\n                        className={`min-h-[40px] px-4 py-2 rounded-lg text-xs font-semibold cursor-pointer whitespace-nowrap shrink-0 ${\\n                          simulateZilischInjury\\n                            ? \'bg-amber-500 text-black\'\\n                            : \'bg-slate-800 text-slate-300\'\\n                        }`}\\n                      >\\n                        {simulateZilischInjury ? \'Simulating DNS\' : \'Normal Start\'}\\n                      </button>\\n                    </div>\\n                  </div>\\n                </div>\\n\\n                {/* NASCAR CDN Feed Pipeline Info */}\\n                <div className=\\\"bg-[#161920] border border-slate-800/90 rounded-2xl p-6 space-y-5\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <h2 className=\\\"font-display text-2xl font-bold tracking-wide text-white\\\">\\n                      cf.nascar.com Feed Pipeline\\n                    </h2>\\n                    <span className=\\\"text-xs font-mono text-slate-400\\\">\\n                      {cdnSchedulesSummary.cup} Cup \302\267{\' \'}\\n                      {cdnSchedulesSummary.oreillys} O&apos;Reilly&apos;s \302\267{\' \'}\\n                      {cdnSchedulesSummary.trucks} Trucks\\n                    </span>\\n                  </div>\\n\\n                  <div className=\\\"space-y-3 text-xs font-mono\\\">\\n                    <div className=\\\"p-3.5 rounded-xl bg-[#0B0D10] border border-slate-800\\\">\\n                      <div className=\\\"text-amber-400 font-semibold\\\">\\n                        01. Schedule &amp; Active Series Detection\\n                      </div>\\n                      <div className=\\\"text-slate-400 truncate mt-1\\\">\\n                        https://cf.nascar.com/cacher/&#123;year&#125;/race_list_basic.json\\n                      </div>\\n                    </div>\\n                    <div className=\\\"p-3.5 rounded-xl bg-[#0B0D10] border border-slate-800\\\">\\n                      <div className=\\\"text-emerald-400 font-semibold\\\">\\n                        02. Live Points &amp; Stage 1/2 Feeds\\n                      </div>\\n                      <div className=\\\"text-slate-400 truncate mt-1\\\">\\n                        https://cf.nascar.com/live/feeds/series_&#123;id&#125;/&#123;race_id&#125;/live_points.json\\n                      </div>\\n                      <div className=\\\"text-slate-400 truncate\\\">\\n                        https://cf.nascar.com/live/feeds/series_&#123;id&#125;/&#123;race_id&#125;/live-stage-points.json\\n                      </div>\\n                    </div>\\n                    <div className=\\\"p-3.5 rounded-xl bg-[#0B0D10] border border-slate-800\\\">\\n                      <div className=\\\"text-blue-400 font-semibold\\\">\\n                        03. Post-Race +3hr &amp; Monday 8:00 AM ET Tech Inspection\\n                      </div>\\n                      <div className=\\\"text-slate-400 truncate mt-1\\\">\\n                        https://cf.nascar.com/cacher/&#123;year&#125;/&#123;id&#125;/&#123;race_id&#125;/weekend-feed.json\\n                      </div>\\n                    </div>\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Dual-Source Verification Table */}\\n              <div className=\\\"bg-[#161920] border border-slate-800/90 rounded-2xl overflow-hidden\\\">\\n                <div className=\\\"p-6 border-b border-slate-800\\\">\\n                  <h2 className=\\\"font-display text-2xl font-bold tracking-wide text-white\\\">\\n                    Dual-Source Scoring Audit: MAX(driver_points, calculated_owner_points)\\n                  </h2>\\n                  <p className=\\\"text-xs text-slate-400 mt-1\\\">\\n                    Verifies that Buschwhackers reporting `points_earned: 0` in NASCAR feeds receive full Vehicle Owner Points (Position + Stage 1/2 + Fastest Lap).\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"overflow-x-auto\\\">\\n                  <table className=\\\"w-full text-left border-collapse text-xs font-mono\\\">\\n                    <thead>\\n                      <tr className=\\\"border-b border-slate-800 bg-[#12151B] text-slate-400\\\">\\n                        <th className=\\\"py-3.5 px-5\\\">Series</th>\\n                        <th className=\\\"py-3.5 px-5\\\">Driver (NASCAR ID)</th>\\n                        <th className=\\\"py-3.5 px-5\\\">Vehicle #</th>\\n                        <th className=\\\"py-3.5 px-5\\\">Finish</th>\\n                        <th className=\\\"py-3.5 px-5\\\">Stage + FL</th>\\n                        <th className=\\\"py-3.5 px-5 text-right\\\">Driver Pts</th>\\n                        <th className=\\\"py-3.5 px-5 text-right\\\">Owner Pts</th>\\n                        <th className=\\\"py-3.5 px-5 text-right text-emerald-400\\\">\\n                          Credited Pts\\n                        </th>\\n                      </tr>\\n                    </thead>\\n                    <tbody className=\\\"divide-y divide-slate-800/70\\\">\\n                      {[\\n                        ...computedWeekendResults[2]\\n                          .slice(0, 4)\\n                          .map((r) => ({ ...r, sId: 2 as SeriesId })),\\n                        ...computedWeekendResults[3]\\n                          .slice(0, 3)\\n                          .map((r) => ({ ...r, sId: 3 as SeriesId })),\\n                      ].map((row, i) => (\\n                        <tr key={i} className=\\\"hover:bg-slate-800/25\\\">\\n                          <td\\n                            className={`py-3.5 px-5 font-semibold ${\\n                              SERIES_META[row.sId].textClass\\n                            }`}\\n                          >\\n                            {SERIES_META[row.sId].shortName}\\n                          </td>\\n                          <td className=\\\"py-3.5 px-5 font-sans font-semibold text-white\\\">\\n                            {row.driver_fullname}{\' \'}\\n                            <span className=\\\"text-slate-500 font-mono\\\">\\n                              ({row.nascar_driver_id})\\n                            </span>\\n                          </td>\\n                          <td className=\\\"py-3.5 px-5 text-amber-400 font-bold\\\">\\n                            #{row.actual_car_number} ({row.actual_team_name})\\n                          </td>\\n                          <td className=\\\"py-3.5 px-5\\\">P{row.finish_position}</td>\\n                          <td className=\\\"py-3.5 px-5\\\">\\n                            +{row.stage_points} Stg{\' \'}\\n                            {row.fastest_lap_bonus ? \'\302\267 +1 FL\' : \'\'}\\n                          </td>\\n                          <td className=\\\"py-3.5 px-5 text-right text-slate-400\\\">\\n                            {row.driver_points}\\n                          </td>\\n                          <td className=\\\"py-3.5 px-5 text-right text-amber-300 font-bold\\\">\\n                            {row.calculated_owner_points}\\n                          </td>\\n                          <td className=\\\"py-3.5 px-5 text-right text-emerald-400 font-bold\\\">\\n                            {row.effective_fantasy_points} (\\n                            {row.scoring_source === \'BUSCHWHACKER_OWNER_PTS\'\\n                              ? \'Owner Pts\'\\n                              : \'Official\'}\\n                            )\\n                          </td>\\n                        </tr>\\n                      ))}\\n                    </tbody>\\n                  </table>\\n                </div>\\n              </div>\\n            </div>\\n          )}\\n        </main>\\n\\n        {/* MOBILE BOTTOM NAVIGATION BAR (<= 15% sticky budget, >= 44px touch targets) */}\\n        <nav className=\\\"md:hidden fixed bottom-0 inset-x-0 h-14 bg-[#12151B]/95 backdrop-blur-md border-t border-slate-800 z-30 grid grid-cols-5 items-center px-1\\\">\\n          {[\\n            { id: \'picks\', label: \'Picks\', icon: Calendar },\\n            { id: \'standings\', label: \'Standings\', icon: Trophy },\\n            { id: \'bank\', label: \'Bank\', icon: Database },\\n            { id: \'draft\', label: \'Roster\', icon: Users },\\n            { id: \'admin\', label: \'Admin\', icon: Sliders },\\n          ].map((item) => {\\n            const Icon = item.icon;\\n            const active = activeTab === item.id;\\n            return (\\n              <button\\n                key={item.id}\\n                onClick={() => setActiveTab(item.id as any)}\\n                className={`min-h-[44px] flex flex-col items-center justify-center rounded-xl text-[10px] font-medium tracking-tight cursor-pointer whitespace-nowrap shrink-0 ${\\n                  active ? \'text-amber-400\' : \'text-slate-400\'\\n                }`}\\n              >\\n                <Icon className=\\\"w-4 h-4\\\" />\\n                <span className=\\\"mt-0.5\\\">{item.label}</span>\\n              </button>\\n            );\\n          })}\\n        </nav>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Build complete Pit Box Fantasy telemetry application in src/App.tsx connected to Cloud SQL PostgreSQL and /api/nascar-sync\", \"Overwrite\":true, \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Building Pit Box Fantasy UI in src/App.tsx\", \"toolSummary\":\"Build Pit Box Fantasy UI in src/App.tsx\"}"
      original_name: "write_to_file"
