        value {
          string_value: "INSERT INTO series_config (id, name, short_name, badge_color, max_weekly_uses_per_driver, chase_active, first_place_points, use_car_anchor_fallback)\nVALUES\n  (1, \'NASCAR Cup Series\', \'Cup\', \'#F59E0B\', 5, true, 55, true),\n  (2, \'NASCAR O\'\'Reilly\'\'s Series\', \'O\'\'Reilly\'\'s\', \'#EF4444\', 5, true, 55, true),\n  (3, \'NASCAR Craftsman Truck Series\', \'Trucks\', \'#3B82F6\', 5, true, 55, true)\nON CONFLICT (id) DO NOTHING;\n\nINSERT INTO drivers (id, nascar_driver_id, series_id, car_number, full_name, team, made_last_year_chase, in_current_chase, is_buschwhacker, active)\nVALUES\n  (\'c1\', 4001, 1, \'5\', \'Kyle Larson\', \'Hendrick Motorsports\', true, true, false, true),\n  (\'c2\', 4002, 1, \'24\', \'William Byron\', \'Hendrick Motorsports\', true, true, false, true),\n  (\'c3\', 4003, 1, \'12\', \'Ryan Blaney\', \'Team Penske\', true, true, false, true),\n  (\'c4\', 4004, 1, \'20\', \'Christopher Bell\', \'Joe Gibbs Racing\', true, true, false, true),\n  (\'c5\', 4005, 1, \'11\', \'Denny Hamlin\', \'Joe Gibbs Racing\', true, true, false, true),\n  (\'c6\', 4006, 1, \'9\', \'Chase Elliott\', \'Hendrick Motorsports\', true, true, false, true),\n  (\'c7\', 4007, 1, \'45\', \'Tyler Reddick\', \'23XI Racing\', true, true, false, true),\n  (\'cn1\', 4101, 1, \'8\', \'Kyle Busch\', \'Richard Childress Racing\', false, true, false, true),\n  (\'cn2\', 4102, 1, \'17\', \'Chris Buescher\', \'RFK Racing\', false, true, false, true),\n  (\'cn3\', 4103, 1, \'23\', \'Bubba Wallace\', \'23XI Racing\', false, false, false, true),\n  (\'cn4\', 4104, 1, \'1\', \'Ross Chastain\', \'Trackhouse Racing\', false, true, false, true),\n  (\'cn5\', 4105, 1, \'54\', \'Ty Gibbs\', \'Joe Gibbs Racing\', false, false, false, true),\n  (\'cn6\', 4106, 1, \'71\', \'Michael McDowell\', \'Spire Motorsports\', false, false, false, true),\n  (\'o1\', 5001, 2, \'88\', \'Connor Zilisch\', \'JR Motorsports\', true, true, false, true),\n  (\'o2\', 5002, 2, \'7