        replacement_content: "  } catch (error) {\n    console.error(\'Database error in getOrCreateUser:\', error);\n    throw new Error(\'Failed to synchronize user profile.\', { cause: error });\n  }\n}\n\nexport async function joinLeagueMember(params: {\n  name: string;\n  email?: string;\n  avatar?: string;\n  inviteCode?: string;\n}) {\n  try {\n    const cleanName = params.name.trim();\n    if (!cleanName) {\n      throw new Error(\'Please enter your Manager or Team Name.\');\n    }\n\n    const allUsers = await db.select().from(users);\n    const nextRank = allUsers.length + 1;\n    const newId = `u_${Date.now().toString(36)}`;\n    const initials =\n      params.avatar?.trim().toUpperCase().slice(0, 2) ||\n      cleanName\n        .split(\' \')\n        .map((w) => w[0])\n        .join(\'\')\n        .toUpperCase()\n        .slice(0, 2) ||\n      \'NP\';\n\n    const insertedUser = await db\n      .insert(users)\n      .values({\n        id: newId,\n        uid: `invite_${newId}`,\n        email:\n          params.email?.trim() ||\n          `${cleanName.toLowerCase().replace(/[^a-z0-9]/g, \'\')}@pitboxfantasy.com`,\n        name: cleanName,\n        avatar: initials,\n        lastYearRank: nextRank,\n        role: \'member\',\n        cumulativePriorPoints: 2300,\n      })\n      .returning();\n\n    // Auto-assign open undrafted season drivers if available so the new manager has a working lineup\n    const allRosters = await db.select().from(seasonRosters);\n    const allDrivers = await db.select().from(drivers);\n    const takenIds = new Set(\n      allRosters\n        .filter((r) => r.slotType !== \'cup_current_chase\')\n        .map((r) => r.driverId)\n    );\n\n    const pickOpenDriver = (\n      sId: number,\n      filterFn: (d: typeof allDrivers[0]) => boolean,\n      fallbackId: string\n    ) => {\n      const found = allDrivers.find(\n        (d) =>\n          d.seriesId === sId &&\n          !d.isBuschwhacker &&\n          !takenIds.has(d.id) &&\n          filterFn(d)\n      );\n      return found || allDrivers.find((d) => d.id === fallbackId)!;\n    };\n\n    const cupChaseDrv = pickOpenDriver(1, (d) => d.madeLastYearChase, \'c7\');\n    takenIds.add(cupChaseDrv.id);\n    const cupNonChaseDrv = pickOpenDriver(\n      1,\n      (d) => !d.madeLastYearChase,\n      \'cn7\'\n    );\n    takenIds.add(cupNonChaseDrv.id);\n    const oreillyDrv = pickOpenDriver(2, () => true, \'o7\');\n    takenIds.add(oreillyDrv.id);\n    const truckDrv = pickOpenDriver(3, () => true, \'t7\');\n    takenIds.add(truckDrv.id);\n\n    const starterSlots = [\n      {\n        seriesId: 1,\n        slotType: \'cup_prev_chase\',\n        driverId: cupChaseDrv.id,\n        fallbackCarNumber: cupChaseDrv.carNumber,\n      },\n      {\n        seriesId: 1,\n        slotType: \'cup_prev_non_chase\',\n        driverId: cupNonChaseDrv.id,\n        fallbackCarNumber: cupNonChaseDrv.carNumber,\n      },\n      {\n        seriesId: 2,\n        slotType: \'oreillys_season\',\n        driverId: oreillyDrv.id,\n        fallbackCarNumber: oreillyDrv.carNumber,\n      },\n      {\n        seriesId: 3,\n        slotType: \'trucks_season\',\n        driverId: truckDrv.id,\n        fallbackCarNumber: truckDrv.carNumber,\n      },\n      {\n        seriesId: 1,\n        slotType: \'cup_current_chase\',\n        driverId: \'c1\',\n        fallbackCarNumber: \'5\',\n      },\n    ];\n\n    for (const s of starterSlots) {\n      await db\n        .insert(seasonRosters)\n        .values({\n          userId: newId,\n          seriesId: s.seriesId,\n          slotType: s.slotType,\n          driverId: s.driverId,\n          fallbackCarNumber: s.fallbackCarNumber,\n        })\n        .onConflictDoNothing();\n    }\n\n    // Assign default weekly picks for the active weekend\n    const defaultWeekly = [\n      { raceId: \'r_cup_bristol\', seriesId: 1, driverId: cupChaseDrv.id },\n      { raceId: \'r_oreillys_bristol\', seriesId: 2, driverId: \'o_bw1\' },\n      { raceId: \'r_trucks_bristol\', seriesId: 3, driverId: \'t_bw1\' },\n    ];\n\n    for (const wp of defaultWeekly) {\n      await db\n        .insert(weeklyPicks)\n        .values({\n          userId: newId,\n          raceId: wp.raceId,\n          seriesId: wp.seriesId,\n          driverId: wp.driverId,\n          trackLabel: \'Bristol Night\',\n          isHistorical: false,\n        })\n        .onConflictDoNothing();\n    }\n\n    return insertedUser[0];\n  } catch (error) {\n    throw new Error(\n      error instanceof Error ? error.message : \'Failed to join league.\',\n      { cause: error }\n    );\n  }\n}"
        start_line: 99
        end_line: 104
      }
      use_global_match: true
    }
    description: "Add joinLeagueMember helper to src/db/repository.ts so new users can sign up via Invite Code or Team Name"
    diff_stats {
      additions: 154
    }
  }
}
