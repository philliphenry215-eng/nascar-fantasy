      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Show locked status and disable already-drafted rival drivers in Exclusive Season Roster dropdowns in src/App.tsx\", \"EndLine\":1058, \"Instruction\":\"Disable rival-owned drivers in exclusive slots 1-4 and show which manager drafted them\", \"ReplacementContent\":\"                          {eligibleDrivers.map((d) => {\\n                            const lockedBySlot = slotCfg.exclusive\\n                              ? (leagueState?.seasonRosters || []).find(\\n                                  (r) =>\\n                                    r.seriesId === slotCfg.seriesId &&\\n                                    r.driverId === d.id &&\\n                                    r.slotType !== \'cup_current_chase\' &&\\n                                    r.userId !== activeManagerId\\n                                )\\n                              : undefined;\\n                            const ownerName = lockedBySlot\\n                              ? (leagueState?.users || []).find(\\n                                  (u) => u.id === lockedBySlot.userId\\n                                )?.name\\n                              : undefined;\\n\\n                            return (\\n                              <option\\n                                key={d.id}\\n                                value={d.id}\\n                                disabled={Boolean(lockedBySlot)}\\n                              >\\n                                #{d.carNumber} {d.fullName}\\n                                {ownerName ? ` (Locked \342\200\224 ${ownerName})` : \'\'}\\n                              </option>\\n                            );\\n                          })}\", \"StartLine\":1052, \"TargetContent\":\"                          {eligibleDrivers.map((d) => (\\n                            <option key={d.id} value={d.id}>\\n                              #{d.carNumber} {d.fullName}\\n                            </option>\\n                          ))}\", \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Updating Exclusive Season Roster selector in src/App.tsx\", \"toolSummary\":\"Update Exclusive Season Roster selector\"}"
